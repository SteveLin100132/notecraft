{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SteveLin100132/notecraft/main/plugins/er-diagram-renderer/schema.json",
  "title": "ER Diagram data",
  "description": "一份資料庫 schema 的表、欄位與外鍵關聯，以及各層的 Wiki 說明。關聯由欄位的 fk 與表的 foreignKeys 推導，不要另外存一份 edges。v1.2 新增 schemas 層與 description；v1.3 新增多重性、複合外鍵、參照欄位、索引與中間表（皆選填，舊版資料檔不改也合法）。",
  "type": "object",
  "required": [
    "requirement",
    "flags",
    "derivations",
    "groups",
    "layout",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "meta": {
      "type": "object",
      "description": "title 與 description 由 NoteCraft 用於頁面標題與搜尋索引；其餘欄位由本 plugin 自行解讀。",
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Wiki 總覽頁內文（Markdown）。也由 NoteCraft 用於頁面描述與搜尋索引——索引時應先去除 Markdown 標記。"
        },
        "source": {
          "type": "string",
          "description": "這份資料整理自哪裡，供日後追溯"
        },
        "backTo": {
          "type": "string",
          "description": "「回到來源筆記」要連去哪"
        }
      }
    },
    "options": {
      "type": "object",
      "description": "資料自帶的預設；plugins.json 傳入的同名設定會覆蓋這裡。",
      "additionalProperties": false,
      "properties": {
        "defaultRows": {
          "type": "integer",
          "minimum": 1,
          "description": "卡片預設顯示幾欄；主鍵與外鍵一律顯示、不計入"
        },
        "hubTables": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "被極多張表指向的共用表（例：選項主檔）。它們的連線預設收起，否則整張圖會被放射狀線條蓋滿。"
        },
        "sectionPrefix": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        },
        "searchPlaceholder": {
          "type": "string"
        },
        "canvasHeight": {
          "type": "integer",
          "minimum": 240,
          "description": "畫布高度（px）。不給就依情境取預設：內嵌 560、獨立頁依視窗高度計算。"
        },
        "collapseJunctions": {
          "type": "boolean",
          "description": "Diagram 預設是否收合中間表（v1.3）。收合時中間表只剩標題列，兩端的表之間畫一條多對多的線；預設 false（展開）。"
        }
      }
    },
    "requirement": {
      "type": "array",
      "minItems": 1,
      "description": "必填性的語彙。欄位的 required 值必須出現在這裡的某個 key。",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label",
          "marker"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "marker": {
            "enum": [
              "solid",
              "half",
              "hollow",
              "muted"
            ],
            "description": "圓點樣式"
          },
          "title": {
            "type": "string",
            "description": "hover 說明，沒寫就用 label"
          },
          "nullable": {
            "type": "boolean",
            "description": "這個必填性在資料庫層是否可為 null（v1.3）。欄位沒寫 nullable 時採用這裡的值；用來推導外鍵父端的多重性。兩處都沒寫時當作不可為 null。"
          }
        }
      }
    },
    "flags": {
      "type": "array",
      "description": "欄位徽章。key 必須是欄位上真的存在的屬性。",
      "items": {
        "type": "object",
        "required": [
          "key",
          "badge"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "enum": [
              "pk",
              "fk",
              "unique",
              "index"
            ]
          },
          "badge": {
            "type": "string",
            "maxLength": 4
          },
          "tone": {
            "enum": [
              "danger",
              "info",
              "success",
              "neutral",
              "warning"
            ],
            "default": "neutral"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "derivations": {
      "type": "array",
      "description": "衍生欄的種類（計算欄、trigger 維護、加密儲存…），一律以 warning 色呈現。",
      "items": {
        "type": "object",
        "required": [
          "key",
          "badge"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "badge": {
            "type": "string",
            "maxLength": 4
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "schemas": {
      "type": "array",
      "description": "導覽第一層（v1.2）。選填；沒有時所有 group 歸在單一隱含 schema 下。順序即導覽順序。",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "description": "建議用資料庫實際的 schema 名，例：crm、sales"
          },
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Schema Wiki 頁內文（Markdown）"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "description": "模組分群。表只記 group key，顯示名集中在這裡，避免每張表重複一次。",
      "items": {
        "type": "object",
        "required": [
          "key",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "description": "對應 schemas[].key（v1.2）。沒寫或找不到時歸入第一個 schema"
          },
          "description": {
            "type": "string",
            "description": "Schema 頁該分群標題下的說明（Markdown）"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "required": [
        "columns"
      ],
      "additionalProperties": false,
      "description": "固定欄數的版面。欄與欄的順序決定外鍵連線要跨幾欄，排得好線就不必繞遠路。",
      "properties": {
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "groups"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "groups": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "由上而下堆疊的 group key"
              }
            }
          }
        }
      }
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "label",
          "group",
          "columns"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "group": {
            "type": "string"
          },
          "columns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "required": {
                  "type": "string",
                  "description": "對應 requirement[].key"
                },
                "default": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "description": "tooltip 內文"
                },
                "fk": {
                  "type": "string",
                  "description": "單欄外鍵的簡寫：寫「表名」時參照父表的主鍵，寫「表名.欄位名」時參照指定欄位（v1.3）。整串剛好是表名時當表名，否則從最後一個 . 切開。指向不存在的表時不畫線，並在開發模式與 build log 提示。"
                },
                "pk": {
                  "type": "boolean"
                },
                "unique": {
                  "type": "boolean"
                },
                "index": {
                  "type": "boolean"
                },
                "derivation": {
                  "type": "string",
                  "description": "對應 derivations[].key"
                },
                "pii": {
                  "type": "boolean",
                  "description": "個資標示。v1.2 渲染器仍不顯示，保留讓資料先記著"
                },
                "nullable": {
                  "type": "boolean",
                  "description": "這一欄是否可為 null（v1.3）。優先於 requirement[].nullable；外鍵欄位可為 null 時，父端多重性是「零或一」。"
                }
              }
            }
          },
          "foreignKeys": {
            "type": "array",
            "description": "表層外鍵（v1.3）。複合外鍵、參照父表主鍵以外的唯一鍵、或要明確指定多重性時使用；單欄外鍵也可以只在欄位上寫 fk。與欄位 fk 描述同一欄時以這裡為準。",
            "items": {
              "type": "object",
              "required": [
                "columns",
                "references"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "約束名稱，顯示在 Wiki"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  },
                  "description": "本表的欄位，順序與 references.columns 逐一配對"
                },
                "references": {
                  "type": "object",
                  "required": [
                    "table"
                  ],
                  "additionalProperties": false,
                  "description": "被參照的父表與欄位",
                  "properties": {
                    "table": {
                      "type": "string",
                      "description": "父表名"
                    },
                    "columns": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      },
                      "description": "父表上被參照的欄位，必須是父表的主鍵或唯一鍵。不寫時用父表的主鍵（含複合主鍵）"
                    }
                  }
                },
                "cardinality": {
                  "type": "object",
                  "additionalProperties": false,
                  "description": "明確指定的多重性，優先於推導結果；只寫一端時另一端照推導。",
                  "properties": {
                    "parent": {
                      "enum": [
                        "one",
                        "zero-or-one"
                      ],
                      "description": "父端：每筆子資料對到幾筆父資料。推導：外鍵欄位都不可為 null 時 one，否則 zero-or-one。"
                    },
                    "child": {
                      "enum": [
                        "zero-or-many",
                        "one-or-many",
                        "zero-or-one",
                        "one"
                      ],
                      "description": "子端：每筆父資料有幾筆子資料。推導：外鍵欄位包含本表的唯一鍵時 zero-or-one（1:1），否則 zero-or-many。one-or-many 與 one 無法由約束推導，只能在這裡寫。"
                    }
                  }
                },
                "note": {
                  "type": "string",
                  "description": "說明，顯示在 Wiki 的關聯清單"
                }
              }
            }
          },
          "indexes": {
            "type": "array",
            "description": "表層索引與唯一約束（v1.3），可含多個欄位。unique: true 的組合會用來推導 1:1。單欄的也可以直接在欄位上寫 unique／index。",
            "items": {
              "type": "object",
              "required": [
                "columns"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "description": "索引或約束名稱，顯示在 Wiki"
                },
                "columns": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string"
                  },
                  "description": "依序列出的欄位"
                },
                "unique": {
                  "type": "boolean",
                  "description": "是否為唯一約束；不寫視為一般索引"
                },
                "note": {
                  "type": "string",
                  "description": "說明，顯示在 Wiki"
                }
              }
            }
          },
          "junction": {
            "type": "boolean",
            "description": "中間表（v1.3）。true：明確標示這張表把兩張表連成多對多；false：關掉自動判斷；不寫：恰好兩組外鍵、合起來是主鍵或唯一鍵、且都不可為 null 時自動視為中間表。"
          },
          "description": {
            "type": "string",
            "description": "Table Wiki 頁的表說明（Markdown）（v1.2）"
          }
        }
      }
    }
  }
}
