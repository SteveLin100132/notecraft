---
/*
 * 請求項旁的示意線稿：每條畫出「它在說的那件事」本身（資料夾、標記、閘門、三個去處、plugin、主機、commit）。
 * 純 SVG、不用 JS；外層 data-draw 交給 scripts/motion.ts 在捲進畫面時沿筆畫描出，文字隨後標上。
 * 顏色：墨線 ink、次要線 ink-2、橙色只標「生成的元件」（與 FIG. 1–4 一致）。
 */
type Props = { n: number };
const { n } = Astro.props;
const id = `ca${n}`;
---

<figure class="ca" data-draw aria-hidden="true">
  <svg viewBox="0 0 320 180" class="ca-svg">
    {n === 1 && (
      <g>
        <path d="M18 76 h16 l6 -7 h30 v48 h-52 z" class="ca-l" />
        <text x="18" y="136" class="ca-t">./docs</text>
        <text x="18" y="152" class="ca-t ca-t--s">原封不動</text>
        <line x1="76" y1="98" x2="96" y2="98" class="ca-l" />
        <path d="M90 93 L96 98 L90 103" class="ca-l" />
        <rect x="100" y="80" width="104" height="36" class="ca-l" />
        <text x="108" y="103" class="ca-t ca-t--b">$ npx … view</text>
        <line x1="206" y1="98" x2="226" y2="98" class="ca-l" />
        <path d="M220 93 L226 98 L220 103" class="ca-l" />
        <rect x="230" y="46" width="82" height="100" class="ca-l" />
        <line x1="230" y1="58" x2="312" y2="58" class="ca-l" />
        <rect x="234" y="62" width="6" height="80" class="ca-s" />
        <rect x="244" y="62" width="18" height="80" class="ca-s" />
        <line x1="268" y1="70" x2="306" y2="70" class="ca-s" />
        <line x1="268" y1="80" x2="298" y2="80" class="ca-s" />
        <line x1="268" y1="90" x2="304" y2="90" class="ca-s" />
        <rect x="268" y="102" width="38" height="24" class="ca-m" />
      </g>
    )}

    {n === 2 && (
      <g>
        <rect x="10" y="36" width="140" height="108" class="ca-l ca-dash" />
        <text x="18" y="58" class="ca-t ca-t--b">@ai-visualize</text>
        <text x="18" y="78" class="ca-t">type: diagram</text>
        <text x="18" y="98" class="ca-t">prompt: |</text>
        <text x="26" y="118" class="ca-t ca-t--s">畫出流程…</text>
        <text x="164" y="26" text-anchor="middle" class="ca-t ca-t--s">Claude Code</text>
        <line x1="164" y1="32" x2="164" y2="84" class="ca-s ca-dash" />
        <line x1="152" y1="90" x2="176" y2="90" class="ca-l" />
        <path d="M170 85 L176 90 L170 95" class="ca-l" />
        <rect x="180" y="36" width="128" height="108" class="ca-l" />
        <rect x="190" y="78" width="26" height="18" class="ca-l" />
        <rect x="229" y="78" width="26" height="18" class="ca-m" />
        <rect x="268" y="78" width="26" height="18" class="ca-l" />
        <line x1="216" y1="87" x2="229" y2="87" class="ca-l" />
        <line x1="255" y1="87" x2="268" y2="87" class="ca-l" />
        <path d="M242 96 V114 H203 V96" class="ca-s ca-dash" />
        <text x="180" y="162" class="ca-t ca-t--s">寫回 repo 的 .tsx</text>
      </g>
    )}

    {n === 3 && (
      <g>
        <rect x="16" y="74" width="56" height="32" class="ca-l" />
        <text x="44" y="95" text-anchor="middle" class="ca-t ca-t--b">tsc</text>
        <rect x="92" y="74" width="60" height="32" class="ca-l" />
        <text x="122" y="95" text-anchor="middle" class="ca-t ca-t--b">build</text>
        <line x1="72" y1="90" x2="92" y2="90" class="ca-l" />
        <path d="M122 74 C122 40, 44 40, 44 70" class="ca-s ca-dash" />
        <path d="M39 64 L44 72 L49 64" class="ca-s" />
        <text x="83" y="38" text-anchor="middle" class="ca-t ca-t--s">失敗就修，最多 3 次</text>
        <line x1="152" y1="90" x2="176" y2="90" class="ca-l" />
        <line x1="184" y1="44" x2="184" y2="136" class="ca-gate" />
        <line x1="176" y1="40" x2="192" y2="56" class="ca-l" />
        <line x1="192" y1="40" x2="176" y2="56" class="ca-l" />
        <rect x="208" y="44" width="96" height="104" class="ca-l" />
        <line x1="218" y1="62" x2="292" y2="62" class="ca-s" />
        <line x1="218" y1="74" x2="282" y2="74" class="ca-s" />
        <line x1="218" y1="86" x2="294" y2="86" class="ca-s" />
        <rect x="218" y="98" width="76" height="36" class="ca-s ca-dash" />
        <text x="208" y="166" class="ca-t ca-t--s">筆記不變</text>
      </g>
    )}

    {n === 4 && (
      <g>
        <defs>
          <symbol id={`${id}-mini`} viewBox="0 0 120 60">
            <rect x="4" y="18" width="26" height="22" class="ca-l" />
            <rect x="47" y="18" width="26" height="22" class="ca-m" />
            <rect x="90" y="18" width="26" height="22" class="ca-l" />
            <line x1="30" y1="29" x2="47" y2="29" class="ca-l" />
            <line x1="73" y1="29" x2="90" y2="29" class="ca-l" />
          </symbol>
        </defs>
        <rect x="14" y="30" width="82" height="128" class="ca-l" />
        <line x1="22" y1="44" x2="86" y2="44" class="ca-s" />
        <line x1="22" y1="54" x2="78" y2="54" class="ca-s" />
        <rect x="22" y="66" width="66" height="40" class="ca-s" />
        <use href={`#${id}-mini`} x="24" y="70" width="62" height="32" />
        <line x1="22" y1="118" x2="84" y2="118" class="ca-s" />
        <text x="14" y="174" class="ca-t ca-t--s">筆記</text>
        <rect x="110" y="30" width="196" height="70" class="ca-l" />
        <line x1="149" y1="30" x2="149" y2="100" class="ca-g" />
        <line x1="188" y1="30" x2="188" y2="100" class="ca-g" />
        <line x1="227" y1="30" x2="227" y2="100" class="ca-g" />
        <line x1="266" y1="30" x2="266" y2="100" class="ca-g" />
        <line x1="110" y1="65" x2="306" y2="65" class="ca-g" />
        <use href={`#${id}-mini`} x="142" y="36" width="132" height="66" />
        <text x="250" y="116" class="ca-t ca-t--s">放大畫布</text>
        <rect x="110" y="110" width="116" height="62" class="ca-l" />
        <line x1="120" y1="122" x2="168" y2="122" class="ca-l ca-thick" />
        <use href={`#${id}-mini`} x="128" y="128" width="80" height="40" />
        <text x="250" y="168" class="ca-t ca-t--s">簡報</text>
      </g>
    )}

    {n === 5 && (
      <g>
        <path d="M16 46 h44 l16 16 v66 h-60 z" class="ca-l" />
        <path d="M60 46 v16 h16" class="ca-l" />
        <text x="46" y="100" text-anchor="middle" class="ca-t ca-t--b">{"{ }"}</text>
        <text x="10" y="150" class="ca-t ca-t--s">schema.er.json</text>
        <line x1="82" y1="88" x2="106" y2="88" class="ca-l" />
        <path d="M100 83 L106 88 L100 93" class="ca-l" />
        <rect x="110" y="66" width="76" height="44" class="ca-l" />
        <text x="148" y="86" text-anchor="middle" class="ca-t ca-t--b">plugin</text>
        <text x="148" y="102" text-anchor="middle" class="ca-t ca-t--s">renderer</text>
        <line x1="186" y1="88" x2="208" y2="88" class="ca-l" />
        <path d="M202 83 L208 88 L202 93" class="ca-l" />
        <rect x="214" y="36" width="46" height="58" class="ca-l" />
        <line x1="214" y1="48" x2="260" y2="48" class="ca-l" />
        <line x1="220" y1="60" x2="250" y2="60" class="ca-s" />
        <line x1="220" y1="70" x2="246" y2="70" class="ca-s" />
        <line x1="220" y1="80" x2="252" y2="80" class="ca-s" />
        <rect x="262" y="104" width="46" height="58" class="ca-l" />
        <line x1="262" y1="116" x2="308" y2="116" class="ca-l" />
        <line x1="268" y1="128" x2="298" y2="128" class="ca-s" />
        <line x1="268" y1="138" x2="292" y2="138" class="ca-s" />
        <path d="M237 94 V130 H262" class="ca-m" />
        <path d="M254 124 L262 130 L254 136" class="ca-m" />
      </g>
    )}

    {n === 6 && (
      <g>
        <path d="M18 70 h16 l6 -7 h30 v48 h-52 z" class="ca-l" />
        <text x="18" y="130" class="ca-t ca-t--b">dist/</text>
        <text x="18" y="146" class="ca-t ca-t--s">HTML・JS・CSS</text>
        <path d="M76 90 C110 90, 110 46, 146 46" class="ca-l" />
        <line x1="76" y1="90" x2="146" y2="90" class="ca-l" />
        <path d="M76 90 C110 90, 110 134, 146 134" class="ca-l" />
        <rect x="150" y="32" width="156" height="28" class="ca-l" />
        <text x="160" y="51" class="ca-t">GitHub Pages</text>
        <rect x="150" y="76" width="156" height="28" class="ca-l" />
        <text x="160" y="95" class="ca-t">Netlify</text>
        <rect x="150" y="120" width="156" height="28" class="ca-l" />
        <text x="160" y="139" class="ca-t">任何靜態主機</text>
        <text x="150" y="172" class="ca-t ca-t--s">不需要 Function 與執行期 API</text>
      </g>
    )}

    {n === 7 && (
      <g>
        <line x1="18" y1="104" x2="302" y2="104" class="ca-l" />
        <path d="M96 104 C96 64, 120 64, 150 64 H200 C230 64, 236 104, 236 104" class="ca-l" />
        <circle cx="40" cy="104" r="7" class="ca-l ca-fill" />
        <circle cx="96" cy="104" r="7" class="ca-l ca-fill" />
        <circle cx="150" cy="64" r="7" class="ca-l ca-fill" />
        <circle cx="200" cy="64" r="7" class="ca-m ca-fill" />
        <circle cx="236" cy="104" r="7" class="ca-l ca-fill" />
        <circle cx="290" cy="104" r="7" class="ca-l ca-fill" />
        <text x="40" y="130" text-anchor="middle" class="ca-t">筆記</text>
        <text x="150" y="46" text-anchor="middle" class="ca-t">標記</text>
        <text x="200" y="46" text-anchor="middle" class="ca-t">元件</text>
        <text x="236" y="130" text-anchor="middle" class="ca-t">merge</text>
        <text x="18" y="164" class="ca-t ca-t--s">可以 diff、review、回到任何一個版本</text>
      </g>
    )}
  </svg>
  <figcaption class="ca-cap">請求項 {n} 示意</figcaption>
</figure>
