---
import { getCollection, render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { CHAPTERS, outlineSlugs, type DocItem } from "../../lib/docs";
import Callout from "../../components/docs/Callout.astro";
import Plate from "../../components/docs/Plate.astro";
import Table from "../../components/docs/Table.astro";
import A from "../../components/docs/A.astro";
import MdDemo from "../../components/docs/MdDemo.astro";
import FeatureMap from "../../components/docs/FeatureMap.astro";
import ArchitectureMap from "../../components/docs/ArchitectureMap.astro";
import Milestones from "../../components/docs/Milestones.astro";

// 內文示意圖：diagrams/ 底下每個 .astro 以檔名當標籤名給 MDX 用（StepFlow、Chain 是給其他圖用的底層，不直接放進文件）
const DIAGRAMS = Object.fromEntries(
  Object.entries(import.meta.glob<{ default: unknown }>("../../components/docs/diagrams/*.astro", { eager: true }))
    .map(([path, mod]) => [path.split("/").pop()!.replace(".astro", ""), mod.default])
    .filter(([name]) => name !== "StepFlow" && name !== "Chain"),
);

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  const known = outlineSlugs();
  const stray = entries.filter((e) => !known.has(e.id)).map((e) => e.id);
  if (stray.length) throw new Error(`src/content/docs 有大綱裡沒有的檔案：${stray.join("、")}（請加進 src/lib/docs.ts）`);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const find = (items: DocItem[]): string | undefined => {
  for (const it of items) {
    if (it.slug === entry.id) return it.title;
    const t = it.children && find(it.children);
    if (t) return t;
  }
};
const title = CHAPTERS.map((c) => find(c.items)).find(Boolean) ?? entry.id;
// 每節的爆炸圖目前不顯示（組裝稿留在 src/lib/figs/，要接回來時用 checkFig 檢查、傳給 layout；
// 單獨驗組裝稿：node --experimental-strip-types scripts/check-figs.mjs）
---

<DocsLayout title={title} description={entry.data.description} slug={entry.id} headings={headings}>
  <Content components={{ Callout, Plate, MdDemo, FeatureMap, ArchitectureMap, Milestones, ...DIAGRAMS, table: Table, a: A }} />
</DocsLayout>
