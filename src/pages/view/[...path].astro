---
// 資料檔檢視頁（Task 48）。
//
// 這條路由刻意不套 BaseLayout 的 1120 版心與 34/40/80 padding —— 資料檔頁就是滿版畫面。
// ER 圖是橫向佈局，1120 都塞不下；渲染器自帶工具列、橫向捲動與全寬覆蓋層，
// 外層再包一層外框卡片或放大檢視都是重複功能（Q22）。
import path from "node:path";
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import Icon from "@/components/Icon.astro";
import PluginHost from "@/components/islands/PluginHost.tsx";
import ReadingControl from "@/components/islands/ReadingControl.tsx";
import DonePrompt from "@/components/islands/DonePrompt.tsx";
import SeriesNav from "@/components/islands/SeriesNav.tsx";
import { getDataFiles, getPlugins } from "@/lib/plugins";
import { getAllNotes } from "@/lib/notes";
import { loadSeries, seriesOf, dataRef } from "@/lib/series";
import { fmtDate, daysAgo } from "@/lib/dates";

export function getStaticPaths() {
  return getDataFiles().map((f) => ({ params: { path: f.routePath }, props: { file: f } }));
}

const { file } = Astro.props;
const plugin = getPlugins().get(file.pluginId);
const isDev = import.meta.env.DEV;
const rendererPath = plugin ? path.join(plugin.dir, "renderer.tsx") : undefined;
const vscodeHref = `vscode://file/${file.absPath.replace(/\\/g, "/").replace(/^\/+/, "")}`;

// meta.backTo 由資料檔自己指定；app 不猜。
const backTo = (file.data as { meta?: { backTo?: string } } | null)?.meta?.backTo;
const updatedDate = file.updatedAt.slice(0, 10);

// 資料檔頁也可以是系列的一章（Q6′）。識別碼是 `view:<routePath>`，
// 同時也是閱讀進度的 localStorage key —— 不剝前綴，否則會與同名筆記撞格。
const ref = dataRef(file.routePath);
const allNotes = await getAllNotes();
const series = seriesOf(allNotes, ref, await loadSeries(), getDataFiles());
const seriesNavData = series
  ? {
      id: series.series.id,
      title: series.series.title,
      eyebrow: series.series.eyebrow,
      accent: series.series.accent,
      icon: series.series.icon,
      chapters: series.chapters.map((c) => ({
        ref: c.ref,
        href: c.href,
        title: c.title,
        kind: c.kind,
        relPath: c.relPath,
      })),
      currentIndex: series.index,
    }
  : null;
---

<WorkbenchLayout
  title={file.title}
  description={file.description}
  rail="plugins"
  back="/view"
  flush
  crumbs={[{ label: "NoteCraft", href: "/" }, { label: "Plugin", href: "/view" }, { label: file.relPath }]}
  pills={[{ label: file.pluginId }]}
>
  {/* data-pagefind-body：Q6 定案這些頁只索引標題與描述。
      專案已在筆記頁用了 data-pagefind-body（notes/[...slug].astro），pagefind 因此處於
      「只索引標記過的區塊」模式 —— 不標的話這頁根本不會進索引。標在頁首而非整頁，
      渲染出來的上千個欄位名就自然被排除。 */}
  <header class="nc-dv-head" data-pagefind-body>
    <div class="nc-dv-row1">
      <a href="/view" class="nc-dv-back">
        <Icon name="chevronLeft" size={16} /> 資料檔
      </a>
      <span class="nc-dv-sep" aria-hidden="true"></span>

      <span class="nc-dv-icon" aria-hidden="true"><Icon name="database" size={18} /></span>

      <div class="nc-dv-titlewrap">
        <div class="nc-dv-titlerow">
          <h1 class="nc-dv-title">{file.title}</h1>
          <span class="nc-dv-kind">DATA FILE</span>
        </div>
        {file.description && <p class="nc-dv-desc">{file.description}</p>}
      </div>

      <div class="nc-dv-actions">
        {series && (
          <a href={`/series/${series.series.id}`} class="nc-dv-btn">
            <Icon name="layers" size={14} /> {series.series.title} 第 {series.index + 1} 章
          </a>
        )}
        {backTo && (
          <a href={backTo} class="nc-dv-btn">
            <Icon name="notes" size={14} /> 回到來源筆記
          </a>
        )}
        {isDev && (
          <a href={vscodeHref} class="nc-dv-btn nc-dv-btn--primary">
            <Icon name="edit" size={14} /> 以 VS Code 編輯
          </a>
        )}
      </div>
    </div>

    <div class="nc-dv-row2">
      <span class="nc-dv-meta"><Icon name="fileJson" size={13} /><code>{file.relPath}</code></span>
      <span class="nc-dv-pill"><Icon name="plug" size={12} /><code>{file.pluginId}</code></span>
      <span class="nc-dv-meta">
        <Icon name="clock" size={13} />{daysAgo(updatedDate)} · {fmtDate(updatedDate)}
      </span>
      {isDev && <code class="nc-dv-route">/view/{file.routePath}</code>}
    </div>
  </header>

  {/* 屬於系列時把 min-height 收掉 —— 否則圖與頁尾導覽之間會空一整屏 */}
  <div class={`nc-dv-stage${series ? " nc-dv-stage--inseries" : ""}`}>
    <PluginHost
      client:load
      pluginId={file.pluginId}
      data={file.data}
      file={{ path: file.relPath, name: path.basename(file.relPath), updatedAt: file.updatedAt }}
      options={file.options}
      mode="page"
      rendererPath={rendererPath}
      isDev={isDev}
    />
  </div>

  {series && (
    <div class="nc-dv-series">
      {/* 開頁即「閱讀中」；「已完成」一律由讀者手動按。與筆記同一套機制、同一個 key。 */}
      <ReadingControl client:idle slug={ref} />
      <DonePrompt client:visible slug={ref} />
      <SeriesNav client:visible series={seriesNavData!} />
    </div>
  )}
</WorkbenchLayout>

<style>
  .nc-dv-head {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--surface-card);
    border-bottom: 1px solid var(--neutral-200);
    padding: 13px clamp(16px, 2.5vw, 34px) 14px;
  }
  .nc-dv-row1 {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .nc-dv-back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 0 auto;
    font-size: 13px;
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
  }
  .nc-dv-back:hover { color: var(--action-link); }
  .nc-dv-sep {
    flex: 0 0 auto;
    width: 1px;
    height: 26px;
    background: var(--border-subtle);
  }
  .nc-dv-icon {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-md);
    background: var(--orange-50);
    color: var(--orange-600);
  }
  .nc-dv-titlewrap { min-width: 0; flex: 1; }
  .nc-dv-titlerow { display: flex; align-items: baseline; gap: 9px; min-width: 0; }
  .nc-dv-title {
    margin: 0;
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
    color: var(--text-strong);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nc-dv-kind {
    flex: 0 0 auto;
    font-size: 11.5px;
    font-weight: var(--weight-bold);
    letter-spacing: 0.05em;
    color: var(--orange-600);
  }
  .nc-dv-desc {
    margin: 1px 0 0;
    font-size: 13px;
    color: var(--text-muted);
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .nc-dv-actions { flex: 0 0 auto; display: flex; gap: 8px; }
  .nc-dv-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    color: var(--text-muted);
    font-size: 12.5px;
    font-weight: var(--weight-bold);
    text-decoration: none;
    white-space: nowrap;
  }
  .nc-dv-btn:hover { border-color: var(--blue-400); color: var(--blue-700); }
  .nc-dv-btn--primary {
    background: var(--action-primary);
    border-color: var(--action-primary);
    color: var(--neutral-0);
  }
  .nc-dv-btn--primary:hover {
    background: var(--action-primary-hover);
    border-color: var(--action-primary-hover);
    color: var(--neutral-0);
  }

  .nc-dv-row2 {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px 18px;
    padding-left: 66px;
    margin-top: 6px;
  }
  .nc-dv-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    color: var(--text-muted);
  }
  .nc-dv-meta code { font-family: var(--font-mono); font-size: 11.5px; }
  .nc-dv-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 9px;
    border-radius: var(--radius-pill);
    background: var(--blue-50);
    color: var(--blue-700);
    font-size: 11.5px;
    font-weight: var(--weight-bold);
  }
  .nc-dv-pill code { font-family: var(--font-mono); }
  .nc-dv-route {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--neutral-400);
  }

  .nc-dv-stage {
    min-height: calc(100vh - 118px);
    background: var(--surface-page);
    padding: 18px clamp(12px, 3vw, 40px) 48px;
  }
  .nc-dv-stage--inseries {
    min-height: 0;
    padding-bottom: 8px;
  }

  /* 渲染區是滿版的，導覽不是 —— 一條橫跨整個螢幕的上一章／下一章沒人想讀 */
  .nc-dv-series {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 40px 72px;
  }
  @media (max-width: 1024px) {
    .nc-dv-series { padding: 0 16px 56px; }
  }

  @media (max-width: 1024px) {
    .nc-dv-row2 { padding-left: 0; }
    .nc-dv-desc { display: none; }
  }
</style>
