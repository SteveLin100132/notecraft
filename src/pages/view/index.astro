---
// 資料檔清單頁（Task 49）。側邊欄「資料 Data」指向這裡。
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import Icon from "@/components/Icon.astro";
import DataFilesList from "@/components/islands/DataFilesList.tsx";
import { getDataFiles, getUsedPlugins } from "@/lib/plugins";

const files = getDataFiles();
const pluginCount = getUsedPlugins().length;
const cards = files.map((f) => ({
  routePath: f.routePath,
  relPath: f.relPath,
  title: f.title,
  description: f.description,
  pluginId: f.pluginId,
  updatedAt: f.updatedAt,
}));
---

<WorkbenchLayout
  title="Plugin 資料檔"
  rail="plugins"
  description="由 plugin 渲染的結構化資料檔"
  crumbs={[{ label: "NoteCraft", href: "/" }, { label: "Plugin" }]}
  pills={[{ label: `${files.length} 個資料檔`, tone: "muted" }]}
>
  <div slot="toolbar" class="wb-tb">
    <span class="wb-tb-lbl">{files.length
      ? `${files.length} 個資料檔 · 由 ${pluginCount} 個 plugin 渲染 · 依檔案 mtime 倒序`
      : "還沒有任何資料檔"}</span>
  </div>
  <div class="wb-host legacy">
  {files.length ? (
    <DataFilesList client:load files={cards} />
  ) : (
    <div
      style="border:1px dashed var(--border-default);border-radius:var(--radius-lg);background:var(--surface-card);padding:40px 28px;text-align:center;"
    >
      <span style="display:inline-flex;align-items:center;justify-content:center;width:46px;height:46px;border-radius:var(--radius-md);background:var(--orange-50);color:var(--orange-600);margin-bottom:14px;">
        <Icon name="database" size={22} />
      </span>
      <h2 style="margin:0 0 8px;font-size:17px;font-weight:700;color:var(--text-strong);">還沒有資料檔</h2>
      <p style="margin:0 auto;max-width:520px;font-size:13.5px;line-height:1.8;color:var(--text-muted);">
        資料檔是被 plugin 畫成頁面的結構化 JSON。裝一個 plugin、在
        <code style="font-family:var(--font-mono);">.notecraft/plugins.json</code>
        寫一條映射，符合的檔案就會出現在這裡。
      </p>
      <pre
        style="margin:16px auto 0;max-width:520px;text-align:left;background:var(--surface-sunken);border-radius:var(--radius-md);padding:12px 14px;font-family:var(--font-mono);font-size:12px;color:var(--text-body);overflow:auto;"
      >npx notecraftapp install-plugin</pre>
    </div>
  )}
  </div>
</WorkbenchLayout>
