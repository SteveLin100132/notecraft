---
// Dashboard：12 欄 widget grid + 三個 Tab（規格 §8.1）。整個主區是同一個 island。
// inline 的 props 只帶精簡列；Drawer 要的完整資料走 /wb-index.json 延遲載入。
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import DashboardWorkbench from "@/components/wb/DashboardWorkbench.tsx";
import { getWorkbenchIndex } from "@/lib/workbench";
import type { WbNoteRow } from "@/lib/wb-types";

const isDev = import.meta.env.DEV;
const index = await getWorkbenchIndex();
// 精簡列：拿掉 description 與標記的 prompt，也不帶 promptPath
const rows: WbNoteRow[] = index.notes.map(({ promptPath: _p, ...r }) => ({
  ...r,
  description: "",
  markers: r.markers.map((m) => ({ ...m, prompt: "" })),
}));
const tags = index.tags.slice(0, 10);
---
<WorkbenchLayout title="儀表板" rail="dashboard" description="NoteCraft 知識總覽" bare>
  <DashboardWorkbench
    client:load
    rows={rows}
    series={index.series}
    tags={tags}
    tagTotal={index.tags.length}
    workspaceLabel={index.workspaceLabel}
    isDev={isDev}
  />
</WorkbenchLayout>
