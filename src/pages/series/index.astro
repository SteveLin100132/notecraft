---
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import SeriesOverview from "@/components/islands/SeriesOverview.tsx";
import type { SeriesCardData } from "@/components/islands/SeriesOverview.tsx";
import { getWorkbenchIndex } from "@/lib/workbench";

const index = await getWorkbenchIndex();
const tagsBySlug = new Map(index.notes.map((n) => [n.slug, n.tags]));

// 章節一篇都解析不到的系列直接略過（例：章節全是被 .gitignore 的 private 筆記，正式站沒有這些檔案）。
const cards: SeriesCardData[] = index.series
  .filter((s) => s.chapters.length > 0)
  .map((s) => ({
    id: s.id,
    title: s.title,
    eyebrow: s.eyebrow,
    description: s.description,
    accent: s.accent,
    icon: s.icon,
    chapters: s.chapters.map((c) => ({ ref: c.ref, title: c.title, tags: c.kind === "note" ? (tagsBySlug.get(c.ref) ?? []) : [] })),
  }));
---
<WorkbenchLayout
  title="系列"
  description="把相關筆記串成有順序的閱讀路徑"
  crumbs={[{ label: "NoteCraft", href: "/" }, { label: "系列" }]}
  pills={[{ label: `${cards.length} 個系列`, tone: "muted" }]}
  bare
>
  <SeriesOverview client:load series={cards} />
</WorkbenchLayout>
