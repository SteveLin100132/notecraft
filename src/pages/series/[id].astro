---
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import SeriesDetail from "@/components/islands/SeriesDetail.tsx";
import type { SeriesDetailData } from "@/components/islands/SeriesDetail.tsx";
import { getAllNotes } from "@/lib/notes";
import { loadSeries, getSeriesChapters } from "@/lib/series";
import { getDataFiles } from "@/lib/plugins";
import { noteRelPath } from "@/lib/workbench";

export async function getStaticPaths() {
  const notes = await getAllNotes();
  const series = await loadSeries();
  const dataFiles = getDataFiles();
  const relBySlug = new Map(notes.map((n) => [n.id, noteRelPath(n)]));
  // 與 /series 一致：零章節的系列不產頁（章節全為 private 筆記時，正式站不會有此路由）。
  return series.flatMap((s) => {
    const chapters = getSeriesChapters(notes, s, dataFiles);
    if (chapters.length === 0) return [];
    const data: SeriesDetailData = {
      id: s.id,
      title: s.title,
      eyebrow: s.eyebrow,
      description: s.description,
      accent: s.accent,
      icon: s.icon,
      chapters: chapters.map((c) => ({
        kind: c.kind,
        ref: c.ref,
        href: c.href,
        title: c.title,
        description: c.description,
        path: c.kind === "data" ? (c.relPath ?? "") : (relBySlug.get(c.ref) ?? c.ref),
        markersTotal: c.markersTotal,
        markersGenerated: c.markersGenerated,
      })),
    };
    return [{ params: { id: s.id }, props: { data } }];
  });
}

const { data } = Astro.props;
const isDev = import.meta.env.DEV;
---
<WorkbenchLayout title={data.title} description={data.description} bare>
  <SeriesDetail client:load series={data} isDev={isDev} />
</WorkbenchLayout>
