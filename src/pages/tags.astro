---
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import TagsManager from "@/components/islands/TagsManager.tsx";
import { getWorkbenchIndex } from "@/lib/workbench";

const isDev = import.meta.env.DEV;
const index = await getWorkbenchIndex();
---
<WorkbenchLayout
  title="標籤"
  description="依標籤瀏覽筆記"
  crumbs={[{ label: "NoteCraft", href: "/" }, { label: "標籤" }]}
  pills={[{ label: `${index.tags.length} 個標籤`, tone: "muted" }]}
  bareBody
>
  <TagsManager client:load initial={index.tags} devMode={isDev} noteCount={index.notes.length} />
</WorkbenchLayout>
