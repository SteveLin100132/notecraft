---
// /notes：整個主區（頁首 Tab、Toolbar、view、Drawer）是同一個 island。
// 只列筆記 —— 資料檔已移出（規格 Q14）；資料檔的入口在 Rail、Sidebar、/plugins、系列頁與 Palette。
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import NotesWorkbench from "@/components/wb/NotesWorkbench.tsx";
import { getWorkbenchIndex, publicIndex } from "@/lib/workbench";

const isDev = import.meta.env.DEV;
const index = publicIndex(await getWorkbenchIndex());
const series = index.series.map((s) => ({
  id: s.id,
  title: s.title,
  accent: s.accent,
  dataChapters: s.chapters.filter((c) => c.kind === "data").length,
}));
---
<WorkbenchLayout title="全部筆記" description="瀏覽所有 NoteCraft 筆記" bare>
  <NotesWorkbench client:load rows={index.notes} series={series} workspaceLabel={index.workspaceLabel} isDev={isDev} />
</WorkbenchLayout>
