---
import { withBase } from "@/lib/base";
import { render } from "astro:content";
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import TagEditor from "@/components/islands/TagEditor.tsx";
import Toc from "@/components/islands/Toc.tsx";
import MoreMenu from "@/components/wb/MoreMenu.tsx";
import { DeckAction, FavoriteIcon } from "@/components/wb/actions.tsx";
import ReadingControl from "@/components/islands/ReadingControl.tsx";
import DonePrompt from "@/components/islands/DonePrompt.tsx";
import SeriesNav from "@/components/islands/SeriesNav.tsx";
import RefLayer from "@/components/islands/RefLayer.tsx";
import RefBacklinks from "@/components/wb/RefBacklinks.tsx";
import NoteSkeleton from "@/components/wb/NoteSkeleton.astro";
import Icon from "@/components/Icon.astro";
import { getAllNotes, noteMarkers, tagStats } from "@/lib/notes";
import { readingMinutes } from "@/lib/note-text";
import { applyNotePaint, notePaint } from "@/lib/note-theme-prepaint";
import { loadSeries, seriesOf } from "@/lib/series";
import { fmtDate } from "@/lib/dates";
import { hasDeck } from "@/lib/decks";
import { getDataFiles } from "@/lib/plugins";
import { getWorkbenchIndex, noteRelPath, promptPathOf } from "@/lib/workbench";
import { notesFolderHref } from "@/lib/wb-routes";
import { ROOT_GROUP } from "@/lib/wb-types";
import { getDefIndex } from "@/lib/defs-state.mjs";
import { noteAbsPath, toVscodeHref } from "@/lib/vscode-href.mjs";
import path from "node:path";
// 數學公式（rehype-katex，note-page §5.2、Q4）：CSS 與字型只在筆記頁載入
import "katex/dist/katex.min.css";

export async function getStaticPaths() {
  const notes = await getAllNotes();
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const markers = noteMarkers(note);
const genCount = markers.filter((m) => m.status === "generated").length;
const pendingMarkers = markers.filter((m) => m.status !== "generated");
const pendingIds = pendingMarkers.map((m) => m.id);
const isDev = import.meta.env.DEV;
const noteHasDeck = hasDeck(note.id);
// Content Layer 的 entry.filePath 平常是相對 cwd 的路徑，但 Windows 上 cwd 與筆記跨磁碟機時會是絕對路徑
// （viewer 模式：app 在 C 槽、筆記在 D 槽），所以要 resolve、不可串接 cwd（見 lib/vscode-href.mjs）。
const vscodeHref = toVscodeHref(noteAbsPath(note.filePath, note.id, process.cwd(), path));

const allNotes = await getAllNotes();
const stats = tagStats(allNotes).map((t) => ({ name: t.name, count: t.count }));
const seriesList = await loadSeries();
const series = seriesOf(allNotes, note.id, seriesList, getDataFiles());
const seriesNavData = series
  ? {
      id: series.series.id,
      title: series.series.title,
      eyebrow: series.series.eyebrow,
      accent: series.series.accent,
      icon: series.series.icon,
      chapters: series.chapters.map((c) => ({ ref: c.ref, href: c.href, title: c.title, kind: c.kind, relPath: c.relPath })),
      currentIndex: series.index,
    }
  : null;

// 麵包屑第三段 = 筆記所在資料夾（真實路徑，不是 slug）
const relPath = noteRelPath(note);
const promptPath = promptPathOf(relPath);
// 頁籤的 localStorage key 依工作區分開；刪除筆記時要關掉對應頁籤（note-tabs §8.2）
const workspaceLabel = (await getWorkbenchIndex()).workspaceLabel;
const folderPath = relPath.includes("/") ? relPath.slice(0, relPath.lastIndexOf("/")) : "";
const aiPill =
  pendingMarkers.length > 0
    ? { label: `待生成 ${pendingMarkers.length}`, tone: "warn" as const }
    : genCount > 0
      ? { label: `已生成 ${genCount}`, tone: "ok" as const }
      : { label: "無標記", tone: "muted" as const };

// 定義與引用（define-ref §7、§8）：本篇有 define／include／ref 才掛 RefLayer；
// 「被 N 篇引用」的清單在 build 期就確定，直接當 props 帶（不另抓 /wb-index.json，沒有載入中狀態）
const defIndex = getDefIndex();
const defNote = defIndex.notes.get(note.id);
const hasDefsUi = !!defNote && (defNote.defines.length + defNote.includes.length + defNote.refs.length > 0);
const backlinkRow = (slug: string, kinds: ("inc" | "ref")[]) => {
  const n = defIndex.notes.get(slug);
  return { slug, title: n?.title ?? slug, folder: n?.folder ?? "", kinds };
};
const pageDefs = (defNote?.defines ?? [])
  .map((id) => defIndex.defs.get(id))
  .filter((d) => !!d)
  .map((d) => ({ id: d.id, label: d.label, refs: d.refs.map((r) => backlinkRow(r.slug, r.kinds)) }));
// 整篇的反向連結（§8.1）：引用本篇任一 define 的筆記；排序＝引用本篇的 id 數多到少，同數依各 define 清單裡先出現的順序
const blMap = new Map<string, { slug: string; title: string; folder: string; ids: { id: string; kinds: ("inc" | "ref")[] }[] }>();
for (const d of pageDefs) {
  for (const r of d.refs) {
    const row = blMap.get(r.slug) ?? { slug: r.slug, title: r.title, folder: r.folder, ids: [] };
    row.ids.push({ id: d.id, kinds: r.kinds });
    blMap.set(r.slug, row);
  }
}
const backlinks = [...blMap.values()].sort((a, b) => b.ids.length - a.ids.length);
const citedDefs = pageDefs.filter((d) => d.refs.length > 0).map((d) => ({ id: d.id, count: d.refs.length }));

// 資訊列（note-page §3、Q8）：閱讀時間在 build 期算；系列連到 /notes?series=
const readMins = readingMinutes(note.body);
const seriesHref = seriesNavData ? withBase(`/notes?series=${encodeURIComponent(seriesNavData.id)}`) : "";
// 主題與字級預繪（§4.3）：函式以原始碼內嵌
const paintSrc = notePaint.toString();
const applySrc = applyNotePaint.toString();

// 目錄收 h1–h3，id 直接用 Astro 幫標題產生的 slug（與內文標題同一個函式，不會對不上）。
// 嵌入的標題（::include）id 是 inc-<defId>-<slug>，TOC 前面加 icon（define-ref §6.1）
const toc = headings
  .filter((h) => h.depth <= 3)
  .map((h) => ({ id: h.slug, label: h.text, lv: h.depth as 1 | 2 | 3, ...(h.slug.startsWith("inc-") ? { inc: true } : {}) }));
---
<WorkbenchLayout
  title={note.data.title}
  description={note.data.description}
  back={withBase("/notes")}
  folderPath={folderPath}
  crumbs={[
    { label: "NoteCraft", href: withBase("/") },
    { label: "筆記", href: withBase("/notes") },
    { label: folderPath || ROOT_GROUP, href: notesFolderHref(folderPath) },
  ]}
  pills={[aiPill]}
  clampTwo
  pagefindTitle
  titleReveal
  flush
  scrollClass="np-scroll np-d"
  tab={{ kind: "note", id: note.id, title: note.data.title, path: relPath, pending: pendingMarkers.length }}
>
  <Fragment slot="actions">
    <DeckAction client:idle slug={note.id} hasDeck={noteHasDeck} promptPath={promptPath} isDev={isDev} />
    {backlinks.length > 0 && <RefBacklinks client:idle title={note.data.title} rows={backlinks} defIds={citedDefs} />}
    <FavoriteIcon client:idle slug={note.id} />
    {isDev && (
      <MoreMenu
        client:idle
        slug={note.id}
        title={note.data.title}
        path={relPath}
        promptPath={promptPath}
        vscodeHref={vscodeHref}
        pendingIds={pendingIds}
        workspace={workspaceLabel}
      />
    )}
  </Fragment>
  {/* 主題與字級在第一次繪製前套上（note-page §4.3）；必須在主區結尾的捲動還原之前 */}
  <script is:inline define:vars={{ paintSrc, applySrc }}>
    try {
      var sc = document.getElementById("nc-scroll");
      var notePaint = new Function("return (" + paintSrc + ")")();
      var applyNotePaint = new Function("return (" + applySrc + ")")();
      if (sc) applyNotePaint(sc, notePaint(localStorage.getItem("nc-workbench-prefs-v1")));
    } catch (e) {}
  </script>
  {/* 骨架在內容之前，內容開頭一到就藏（loading-transitions §8.3） */}
  <div class="nc-body-wrap">
  <NoteSkeleton toc={toc.length > 0} />
  <div class="np-host nc-content">
  <div class:list={["np-page", { "has-toc": toc.length > 0 }]}>
    <article class="md-art">
      <header class="md-head">
        <div class="md-tags">
          <TagEditor
            client:load
            slug={note.id}
            initialTags={note.data.tags}
            editable={isDev}
            suggestions={stats}
          />
        </div>
        <h1 class="md-h1" id="nc-note-title">{note.data.title}</h1>
        {note.data.description && <p class="md-desc">{note.data.description}</p>}
        <div class="md-meta">
          <a class="mi" href={notesFolderHref(folderPath)}>
            <Icon name="folder" size={13} /> {folderPath || ROOT_GROUP}
          </a>
          <span class="mi">
            <Icon name="clock" size={13} /> 更新於 {fmtDate(note.data.updatedAt)}
          </span>
          <span class="mi">
            <Icon name="book" size={13} /> 約 {readMins} 分鐘
          </span>
          {seriesNavData && (
            <a class="mi" href={seriesHref}>
              <Icon name="layers" size={13} /> {seriesNavData.title} · {seriesNavData.currentIndex + 1}/{seriesNavData.chapters.length}
            </a>
          )}
          <ReadingControl client:idle slug={note.id} />
          {backlinks.length > 0 && (
            <button type="button" class="rf-bl-meta" data-nc-bl-open aria-haspopup="dialog" aria-expanded="false">
              <Icon name="cornerDownRight" size={14} /> 被 <b>{backlinks.length}</b> 篇筆記引用
            </button>
          )}
        </div>
      </header>

      <div class="md-flow nc-prose" data-pagefind-body>
        <Content />
      </div>

      {hasDefsUi && <RefLayer client:idle defs={pageDefs} isDev={isDev} />}

      <DonePrompt client:visible slug={note.id} />

      {seriesNavData && <SeriesNav series={seriesNavData} />}

      <div class="md-foot">
        <span>建立於 {fmtDate(note.data.createdAt)}</span>
        <span class="mono">{relPath}</span>
      </div>
    </article>

    {toc.length > 0 && (
      <div class="nc-toc-col">
        <Toc client:visible items={toc} />
      </div>
    )}
  </div>
  </div>
  </div>
  <noscript><style>.wb-hd-title.reveal{opacity:1;visibility:visible;max-width:none}</style></noscript>
</WorkbenchLayout>


<script>
  import { COPY_FAILED_MSG, writeClipboard } from "@/lib/clipboard";
  import { initAllTabs } from "@/lib/nc-tabs";
  import { initTips } from "@/lib/nc-tip";

  import { applyNotePaint, notePaint } from "@/lib/note-theme-prepaint";
  import { PREFS_EVENT, PREFS_KEY } from "@/lib/wb-prefs";

  // Content tabs 與 Tooltips 的初始化在 lib/nc-tabs.ts、lib/nc-tip.ts（預覽卡 RefLayer 也要用）
  initAllTabs(document);
  initTips(document);

  // 標題錨點（note-page §5.1）：hover 時左側出現 #。在瀏覽器插入：不進 pagefind 索引、也不影響 build 期的目錄文字
  document.querySelectorAll<HTMLElement>(".md-flow :is(h1, h2, h3, h4, h5, h6)[id]").forEach((h) => {
    if (h.closest(".nc-viz") || h.querySelector(":scope > .nc-anc")) return;
    const a = document.createElement("a");
    a.className = "nc-anc";
    a.href = `#${h.id}`;
    a.textContent = "#";
    a.setAttribute("aria-hidden", "true");
    a.tabIndex = -1;
    h.prepend(a);
  });

  // 待辦清單（§5.7）：GFM 輸出的 checkbox 是 disabled；在閱讀畫面可以勾，但只改畫面、不寫回檔案也不保存
  document.querySelectorAll<HTMLInputElement>(".md-flow li.task-list-item input[type=checkbox]").forEach((cb) => {
    cb.disabled = false;
    const li = cb.closest("li");
    const label = li?.textContent?.trim();
    if (label) cb.setAttribute("aria-label", label);
  });

  // 主題與字級（note-page §4.2）：預繪已在第一次繪製前套上；這裡只接之後的變更（同分頁事件、其他分頁的 storage）
  {
    const sc = document.getElementById("nc-scroll");
    const repaint = () => {
      try {
        if (sc) applyNotePaint(sc, notePaint(localStorage.getItem(PREFS_KEY)));
      } catch {
        /* localStorage 不可用：維持 SSR 的品牌主題 */
      }
    };
    window.addEventListener(PREFS_EVENT, repaint);
    window.addEventListener("storage", (e) => {
      if (e.key === PREFS_KEY) repaint();
    });
  }

  // 頁首標題（note-page §3.2、Q3）：文內 H1 還看得到時隱藏，捲過它之後才淡入
  {
    const sc = document.getElementById("nc-scroll");
    const h1 = document.getElementById("nc-note-title");
    const hd = document.querySelector<HTMLElement>(".wb-hd-title.reveal");
    if (sc && h1 && hd && "IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        ([e]) => hd.classList.toggle("is-shown", !e.isIntersecting && e.boundingClientRect.top < (e.rootBounds?.top ?? 0)),
        { root: sc, threshold: 0 },
      );
      io.observe(h1);
    } else if (hd) {
      hd.classList.add("is-shown");
    }
  }
  // meta 列的「被 N 篇筆記引用」→ RefBacklinks 開 Drawer（define-ref §8.1）
  document.querySelectorAll<HTMLElement>("[data-nc-bl-open]").forEach((b) =>
    b.addEventListener("click", () => window.dispatchEvent(new Event("nc-backlinks-open"))),
  );

  // Code annotations（PRD §7.1 / task-20）漸進增強：點擊程式碼中的 (n) 標記，浮現對應說明氣泡。
  // 標記由 EC 外掛產生（.nc-anno-marker[data-anno]）；說明為 .nc-anno-item（id=nc-anno-{uid}-{n}）。
  // 未載入此 script 時，CSS 讓說明清單以一般有序清單依序顯示（不遺失內容）。
  function initAnnotate(root: HTMLElement) {
    const markers = Array.from(root.querySelectorAll<HTMLElement>(".nc-anno-marker"));
    const items = Array.from(root.querySelectorAll<HTMLElement>(".nc-anno-item"));
    if (!markers.length || !items.length) return;
    root.setAttribute("data-enhanced", "");

    const byN = new Map<string, HTMLElement>();
    items.forEach((it) => {
      const n = it.getAttribute("data-anno");
      if (n) byN.set(n, it);
    });

    let openItem: HTMLElement | null = null;
    let openMarker: HTMLElement | null = null;

    const close = () => {
      if (openItem) openItem.classList.remove("is-open");
      if (openMarker) openMarker.setAttribute("aria-expanded", "false");
      openItem = null;
      openMarker = null;
    };

    // 彈窗位置（note-page §5.4）：圓圈下方 14px、往左 280px，夾在程式碼區塊的寬度內；下方放不下時改放上方
    const position = (item: HTMLElement, marker: HTMLElement) => {
      item.style.left = "0px";
      item.style.top = "0px";
      const tr = marker.getBoundingClientRect();
      const box = (marker.closest(".nc-cb") ?? root).getBoundingClientRect();
      const bw = item.offsetWidth;
      const bh = item.offsetHeight;
      const minX = Math.max(8, box.left + 8);
      const maxX = Math.min(window.innerWidth - 8, box.right - 8);
      const left = Math.max(minX, Math.min(tr.left - 280, maxX - bw));
      let top = tr.bottom + 14;
      if (top + bh > window.innerHeight - 8) top = Math.max(8, tr.top - bh - 14);
      item.style.left = `${Math.round(left)}px`;
      item.style.top = `${Math.round(top)}px`;
    };

    const open = (marker: HTMLElement) => {
      const n = marker.getAttribute("data-anno");
      const item = n ? byN.get(n) : null;
      if (!item) return;
      close();
      item.classList.add("is-open");
      marker.setAttribute("aria-expanded", "true");
      openItem = item;
      openMarker = marker;
      position(item, marker);
    };

    markers.forEach((marker) => {
      const n = marker.getAttribute("data-anno");
      const item = n ? byN.get(n) : null;
      if (item) marker.setAttribute("aria-controls", item.id);
      marker.setAttribute("aria-expanded", "false");
      const toggle = () => (openMarker === marker ? close() : open(marker));
      marker.addEventListener("click", (e) => {
        e.stopPropagation();
        toggle();
      });
      marker.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });

    // Esc 晚一拍處理：工作台的 wb-escape 也掛在 window，別人（Palette／Drawer）先處理了就讓位
    window.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key !== "Escape" || !openMarker) return;
      setTimeout(() => {
        if (e.defaultPrevented || !openMarker) return;
        const m = openMarker;
        close();
        m.focus();
      });
    });
    document.getElementById("nc-scroll")?.addEventListener("scroll", () => openItem && close(), { passive: true });
    document.addEventListener("click", (e) => {
      if (openItem && !openItem.contains(e.target as Node)) close();
    });
    window.addEventListener("resize", () => {
      if (openItem && openMarker) position(openItem, openMarker);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-nc-annotate]").forEach(initAnnotate);

  // 程式碼塊複製鈕（design_handoff_mdx_codeblock）：複製原始碼，真的寫進剪貼簿才顯示「已複製」綠勾（1.6s）。
  // 失敗（非安全連線且 execCommand 也不行）→ 選取程式碼、標籤改「無法複製」並提示手動複製，讓使用者自己按複製。
  document.querySelectorAll<HTMLButtonElement>(".nc-cb__copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>(".nc-cb__copy-label");
    const textCopy = label?.dataset.copy ?? "複製";
    const textCopied = label?.dataset.copied ?? "已複製";
    let timer: number | undefined;
    const show = (text: string, copied: boolean, ms: number) => {
      btn.classList.toggle("is-copied", copied);
      if (label) label.textContent = text;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove("is-copied");
        if (label) label.textContent = textCopy;
      }, ms);
    };
    btn.addEventListener("click", async () => {
      const code = btn.getAttribute("data-code") ?? "";
      if (await writeClipboard(code)) {
        show(textCopied, true, 1600);
        return;
      }
      const codeEl = btn.closest(".nc-cb")?.querySelector(".nc-cb__code");
      if (codeEl) window.getSelection()?.selectAllChildren(codeEl);
      show("無法複製", false, 2400);
      window.dispatchEvent(new CustomEvent("nc-toast", { detail: { msg: COPY_FAILED_MSG, icon: "x" } }));
    });
  });
</script>
