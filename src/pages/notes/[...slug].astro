---
import { render } from "astro:content";
import WorkbenchLayout from "@/layouts/WorkbenchLayout.astro";
import TagEditor from "@/components/islands/TagEditor.tsx";
import Toc from "@/components/islands/Toc.tsx";
import MoreMenu from "@/components/wb/MoreMenu.tsx";
import { DeckAction, FavoriteIcon } from "@/components/wb/actions.tsx";
import ReadingControl from "@/components/islands/ReadingControl.tsx";
import DonePrompt from "@/components/islands/DonePrompt.tsx";
import SeriesNav from "@/components/islands/SeriesNav.tsx";
import AiMarkerCard from "@/components/AiMarkerCard.astro";
import Icon from "@/components/Icon.astro";
import { getAllNotes, parseMarkers, tagStats } from "@/lib/notes";
import { loadSeries, seriesOf } from "@/lib/series";
import { fmtDate } from "@/lib/dates";
import { hasDeck } from "@/lib/decks";
import { getDataFiles } from "@/lib/plugins";
import { noteRelPath, promptPathOf } from "@/lib/workbench";
import { notesFolderHref } from "@/lib/wb-routes";
import { ROOT_GROUP } from "@/lib/wb-types";

export async function getStaticPaths() {
  const notes = await getAllNotes();
  return notes.map((n) => ({ params: { slug: n.id }, props: { note: n } }));
}

const { note } = Astro.props;
const { Content, headings } = await render(note);
const markers = parseMarkers(note.body);
const genCount = markers.filter((m) => m.status === "generated").length;
const pendingMarkers = markers.filter((m) => m.status !== "generated");
const pendingIds = pendingMarkers.map((m) => m.id);
const isDev = import.meta.env.DEV;
const noteHasDeck = hasDeck(note.id);
// Content Layer 的 entry.filePath 是相對於 cwd 的來源路徑；vscode:// 需要絕對正斜線路徑。
const noteAbsPath = note.filePath
  ? `${process.cwd()}/${note.filePath}`
  : `${process.cwd()}/src/content/notes/${note.id}.mdx`;
const vscodeHref = `vscode://file/${noteAbsPath.replace(/\\/g, "/").replace(/^\/+/, "")}`;

const allNotes = await getAllNotes();
const stats = tagStats(allNotes).map((t) => ({ name: t.name, count: t.count }));
const seriesList = await loadSeries();
const series = seriesOf(allNotes, note.id, seriesList, getDataFiles());
const seriesNavData = series
  ? {
      id: series.series.id,
      title: series.series.title,
      eyebrow: series.series.eyebrow,
      accent: series.series.accent,
      icon: series.series.icon,
      chapters: series.chapters.map((c) => ({ ref: c.ref, href: c.href, title: c.title, kind: c.kind, relPath: c.relPath })),
      currentIndex: series.index,
    }
  : null;

// 麵包屑第三段 = 筆記所在資料夾（真實路徑，不是 slug）
const relPath = noteRelPath(note);
const promptPath = promptPathOf(relPath);
const folderPath = relPath.includes("/") ? relPath.slice(0, relPath.lastIndexOf("/")) : "";
const aiPill =
  pendingMarkers.length > 0
    ? { label: `待生成 ${pendingMarkers.length}`, tone: "warn" as const }
    : genCount > 0
      ? { label: `已生成 ${genCount}`, tone: "ok" as const }
      : { label: "無標記", tone: "muted" as const };

// 目錄收 h1–h3，id 直接用 Astro 幫標題產生的 slug（與內文標題同一個函式，不會對不上）
const toc = headings
  .filter((h) => h.depth <= 3)
  .map((h) => ({ id: h.slug, label: h.text, lv: h.depth as 1 | 2 | 3 }));
---
<WorkbenchLayout
  title={note.data.title}
  description={note.data.description}
  back="/notes"
  folderPath={folderPath}
  crumbs={[
    { label: "NoteCraft", href: "/" },
    { label: "筆記", href: "/notes" },
    { label: folderPath || ROOT_GROUP, href: notesFolderHref(folderPath) },
  ]}
  pills={[aiPill]}
  clampTwo
  pagefindTitle
>
  <Fragment slot="actions">
    <DeckAction client:idle slug={note.id} hasDeck={noteHasDeck} promptPath={promptPath} isDev={isDev} />
    <FavoriteIcon client:idle slug={note.id} />
    {isDev && (
      <MoreMenu
        client:idle
        slug={note.id}
        title={note.data.title}
        path={relPath}
        promptPath={promptPath}
        vscodeHref={vscodeHref}
        pendingIds={pendingIds}
        componentIds={markers.map((m) => m.id)}
      />
    )}
  </Fragment>
  <div class="wb-host">
  <div class={`nc-note-grid ${toc.length ? "has-toc" : ""}`}>
    <article class="nc-note-article" style="min-width:0;">
      <div style="margin-bottom:14px;">
        <TagEditor
          client:load
          slug={note.id}
          initialTags={note.data.tags}
          editable={isDev}
          suggestions={stats}
        />
      </div>

      <p style="font-size:var(--text-lg);color:var(--text-muted);line-height:1.7;margin:0 0 18px;">
        {note.data.description}
      </p>

      <div
        style="display:flex;flex-direction:column;gap:14px;padding-bottom:18px;margin-bottom:8px;border-bottom:1px solid var(--neutral-200);"
      >
        <div
          style="display:flex;flex-wrap:wrap;align-items:center;gap:14px;font-size:13px;color:var(--text-muted);"
        >
          <span style="display:inline-flex;align-items:center;gap:5px;">
            <Icon name="clock" size={15} /> 更新於 {fmtDate(note.data.updatedAt)}
          </span>
          <ReadingControl client:idle slug={note.id} />
        </div>
      </div>

      {/* 已生成的標記，其提示詞已由下方 GeneratedFrame 卡片（含複製按鈕）呈現，
          這裡只保留尚未生成（pending / failed / locked）的標記提示，避免重複。 */}
      {pendingMarkers.length > 0 && (
        <div style="margin:18px 0 6px;">
          {pendingMarkers.map((m) => (
            <AiMarkerCard id={m.id} type={m.type} status={m.status} prompt={m.prompt} />
          ))}
        </div>
      )}

      <div class="nc-prose" data-pagefind-body>
        <Content />
      </div>

      <DonePrompt client:visible slug={note.id} />

      <div
        style="margin-top:44px;padding-top:22px;border-top:1px solid var(--neutral-200);display:flex;justify-content:space-between;color:var(--text-muted);font-size:13px;"
      >
        <span>建立於 {fmtDate(note.data.createdAt)}</span>
        <span style="font-family:var(--font-mono);">{relPath}</span>
      </div>

      {seriesNavData && <SeriesNav client:visible series={seriesNavData} />}
    </article>

    {toc.length > 0 && (
      <div class="nc-toc-col">
        <Toc client:visible items={toc} />
      </div>
    )}
  </div>
  </div>
</WorkbenchLayout>

<style is:global>
  /* 筆記頁內文滿版：解除 global.css 的 .nc-prose 760px 上限（PluginView 仍保留） */
  .nc-note-article .nc-prose {
    max-width: none;
  }
  .nc-note-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
  }
  /* TOC 斷點（Task 74）：以「內文欄至少 640px」為準，不看視窗寬。
     新殼吃掉 Rail 52 + Sidebar 240，同樣的視窗寬主區窄很多；平板時 Sidebar 又收成抽屜，
     用視窗寬換算要算兩套。改用 container query 量 .wb-host 的內容寬：
     640（內文）+ 40（gap）+ 220（TOC）= 900。桌面約落在視窗 1256、平板約 1016。 */
  .wb-host {
    container-type: inline-size;
    container-name: wbhost;
  }
  @container wbhost (min-width: 900px) {
    .nc-note-grid.has-toc {
      grid-template-columns: 1fr 220px;
    }
    /* 讓目錄欄拉伸到整欄高度，sticky 才有可黏附的範圍 */
    .nc-toc-col {
      align-self: stretch;
    }
  }
  /* 桌面：右側黏性目錄 */
  .nc-toc {
    position: sticky;
    top: 8px;
    /* 目錄過長時自己捲，不撐開頁面 */
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 4px;
  }
  /* 標頭列：標題按鈕（窄版時負責折疊面板）＋「全部展開／收合」按鈕 */
  .nc-toc-head {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 12px;
  }
  .nc-toc-title {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 6px;
    padding: 0;
    border: none;
    background: none;
    font-family: var(--font-sans);
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: default;
  }
  .nc-toc-head-r {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nc-toc-count {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    font-variant-numeric: tabular-nums;
  }
  /* 桌面不需要折疊箭頭 */
  .nc-toc-chevron {
    display: none;
  }

  /* 扁平清單，用縮排表現層級：左 padding = 14 + depth × 12 */
  .nc-toc-list {
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-left: 2px solid var(--neutral-200);
  }
  /* 一列 = 連結 + 可選的展開鈕；連結不包在按鈕裡 */
  .nc-toc-row {
    display: flex;
    align-items: center;
  }
  .nc-toc-row > .nc-toc-item {
    flex: 1;
    min-width: 0;
  }
  .nc-toc-twisty,
  .nc-toc-all {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 140ms, background 140ms;
  }
  .nc-toc-twisty:hover,
  .nc-toc-all:hover {
    color: var(--blue-700);
    background: var(--neutral-100);
  }
  .nc-toc-twisty:focus-visible,
  .nc-toc-all:focus-visible {
    outline: 2px solid var(--blue-700);
    outline-offset: -2px;
  }
  .nc-toc-twisty svg {
    transition: transform 200ms ease-out;
  }
  .nc-toc-item {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    line-height: 1.5;
    text-decoration: none;
    transition: color 140ms, border-color 140ms;
  }
  .nc-toc-item.d0 {
    padding: 5px 10px 5px 14px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--text-muted);
  }
  .nc-toc-item.d1 {
    padding: 3px 10px 3px 26px;
    font-size: 12.5px;
    font-weight: 400;
    color: var(--text-body);
  }
  .nc-toc-item.d2 {
    padding: 3px 10px 3px 38px;
    font-size: 12px;
    font-weight: 400;
    color: var(--text-muted);
    opacity: 0.85;
  }
  .nc-toc-mark {
    flex: none;
    background: var(--neutral-300);
    transition: background 140ms;
  }
  .nc-toc-item.d1 .nc-toc-mark {
    width: 4px;
    height: 4px;
    border-radius: 999px;
  }
  .nc-toc-item.d2 .nc-toc-mark {
    width: 8px;
    height: 1.5px;
  }
  .nc-toc-label {
    min-width: 0;
  }
  .nc-toc-item:hover {
    color: var(--blue-700);
  }
  /* 目前位置的祖先 */
  .nc-toc-item.trail {
    color: var(--blue-700);
    font-weight: 600;
    opacity: 1;
  }
  .nc-toc-item.on {
    border-left-color: var(--orange-500);
    color: var(--blue-700);
    font-weight: 700;
    opacity: 1;
  }
  /* 目前位置藏在收合的分支裡：看得到的最近祖先代為標橘色左緣 */
  .nc-toc-item.proxy {
    border-left-color: var(--orange-500);
  }
  .nc-toc-item.on .nc-toc-mark {
    background: var(--orange-500);
  }

  /* 主區不夠寬：單欄 + 目錄改為可折疊面板置於內文上方 */
  @container wbhost (max-width: 899.98px) {
    .nc-note-grid {
      gap: 0;
    }
    .nc-toc-col {
      order: -1;
      margin-bottom: 18px;
    }
    .nc-toc {
      position: static;
      max-height: none;
      overflow: visible;
      border: 1px solid var(--neutral-200);
      border-radius: var(--radius-lg);
      background: #fff;
      padding: 12px 16px;
      box-shadow: var(--shadow-xs);
    }
    .nc-toc-head {
      margin-bottom: 0;
    }
    .nc-toc-head:has(> .nc-toc-title[aria-expanded="true"]) {
      margin-bottom: 12px;
    }
    .nc-toc-title {
      align-items: center;
      cursor: pointer;
    }
    .nc-toc-chevron {
      display: inline-flex;
      transition: transform 200ms ease-out;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nc-toc-chevron,
    .nc-toc-item,
    .nc-toc-mark,
    .nc-toc-twisty,
    .nc-toc-twisty svg,
    .nc-toc-all {
      transition: none;
    }
  }
</style>

<script>
  // Content tabs（PRD §7.1 / task-15）漸進增強：框架無關 vanilla JS，不引入 React island。
  // 無此 script 時 CSS 會展開所有面板（不遺失內容）；載入後才接管切換。
  function initTabs(root: HTMLElement) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (!tabs.length) return;
    root.setAttribute("data-enhanced", "");

    const select = (i: number) => {
      tabs.forEach((tab, j) => {
        const selected = j === i;
        tab.setAttribute("aria-selected", selected ? "true" : "false");
        tab.tabIndex = selected ? 0 : -1;
        if (panels[j]) panels[j].hidden = !selected;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => {
        select(i);
        tab.focus();
      });
      tab.addEventListener("keydown", (e: KeyboardEvent) => {
        let next: number | null = null;
        if (e.key === "ArrowRight") next = (i + 1) % tabs.length;
        else if (e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
        else if (e.key === "Home") next = 0;
        else if (e.key === "End") next = tabs.length - 1;
        else return;
        e.preventDefault();
        select(next);
        tabs[next].focus();
      });
    });

    const initial = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
    select(initial < 0 ? 0 : initial);
  }

  document.querySelectorAll<HTMLElement>("[data-nc-tabs]").forEach(initTabs);

  // Tooltips（PRD §7.1 / task-16）定位：氣泡採 position:fixed，於 hover / focus 時以 JS
  // 夾在內容捲動區內，避免被 table/tabs 的 overflow 裁切、超出視窗或被 sidebar 遮蔽。
  function positionTip(tip: HTMLElement) {
    const bubble = tip.querySelector<HTMLElement>(".nc-tip__bubble");
    if (!bubble) return;
    bubble.style.left = "0px";
    bubble.style.top = "0px";
    const tr = tip.getBoundingClientRect();
    const bw = bubble.offsetWidth;
    const bh = bubble.offsetHeight;
    const scroll = document.getElementById("nc-scroll");
    const sr = scroll
      ? scroll.getBoundingClientRect()
      : ({ left: 8, right: window.innerWidth - 8, top: 8 } as DOMRect);
    const minX = Math.max(8, sr.left + 8);
    const maxX = Math.min(window.innerWidth - 8, sr.right - 8);
    let left = tr.left + tr.width / 2 - bw / 2;
    left = Math.max(minX, Math.min(left, maxX - bw));
    let top = tr.top - bh - 9;
    const below = top < sr.top + 8;
    if (below) top = tr.bottom + 9;
    bubble.style.left = `${Math.round(left)}px`;
    bubble.style.top = `${Math.round(top)}px`;
    bubble.style.setProperty(
      "--nc-tip-arrow",
      `${Math.round(tr.left + tr.width / 2 - left)}px`,
    );
    bubble.classList.toggle("nc-tip__bubble--below", below);
  }

  document.querySelectorAll<HTMLElement>(".nc-tip").forEach((tip) => {
    tip.addEventListener("mouseenter", () => positionTip(tip));
    tip.addEventListener("focusin", () => positionTip(tip));
  });

  // Code annotations（PRD §7.1 / task-20）漸進增強：點擊程式碼中的 (n) 標記，浮現對應說明氣泡。
  // 標記由 EC 外掛產生（.nc-anno-marker[data-anno]）；說明為 .nc-anno-item（id=nc-anno-{uid}-{n}）。
  // 未載入此 script 時，CSS 讓說明清單以一般有序清單依序顯示（不遺失內容）。
  function initAnnotate(root: HTMLElement) {
    const markers = Array.from(root.querySelectorAll<HTMLElement>(".nc-anno-marker"));
    const items = Array.from(root.querySelectorAll<HTMLElement>(".nc-anno-item"));
    if (!markers.length || !items.length) return;
    root.setAttribute("data-enhanced", "");

    const byN = new Map<string, HTMLElement>();
    items.forEach((it) => {
      const n = it.getAttribute("data-anno");
      if (n) byN.set(n, it);
    });

    let openItem: HTMLElement | null = null;
    let openMarker: HTMLElement | null = null;

    const close = () => {
      if (openItem) openItem.classList.remove("is-open");
      if (openMarker) openMarker.setAttribute("aria-expanded", "false");
      openItem = null;
      openMarker = null;
    };

    const position = (item: HTMLElement, marker: HTMLElement) => {
      item.style.left = "0px";
      item.style.top = "0px";
      const tr = marker.getBoundingClientRect();
      const bw = item.offsetWidth;
      const bh = item.offsetHeight;
      const scroll = document.getElementById("nc-scroll");
      const sr = scroll
        ? scroll.getBoundingClientRect()
        : ({ left: 8, right: window.innerWidth - 8 } as DOMRect);
      const minX = Math.max(8, sr.left + 8);
      const maxX = Math.min(window.innerWidth - 8, sr.right - 8);
      let left = tr.left + tr.width / 2 - bw / 2;
      left = Math.max(minX, Math.min(left, maxX - bw));
      let top = tr.bottom + 8;
      if (top + bh > window.innerHeight - 8) top = Math.max(8, tr.top - bh - 8);
      item.style.left = `${Math.round(left)}px`;
      item.style.top = `${Math.round(top)}px`;
    };

    const open = (marker: HTMLElement) => {
      const n = marker.getAttribute("data-anno");
      const item = n ? byN.get(n) : null;
      if (!item) return;
      close();
      item.classList.add("is-open");
      marker.setAttribute("aria-expanded", "true");
      openItem = item;
      openMarker = marker;
      position(item, marker);
    };

    markers.forEach((marker) => {
      const n = marker.getAttribute("data-anno");
      const item = n ? byN.get(n) : null;
      if (item) marker.setAttribute("aria-controls", item.id);
      marker.setAttribute("aria-expanded", "false");
      const toggle = () => (openMarker === marker ? close() : open(marker));
      marker.addEventListener("click", (e) => {
        e.stopPropagation();
        toggle();
      });
      marker.addEventListener("keydown", (e: KeyboardEvent) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          toggle();
        }
      });
    });

    document.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Escape" && openMarker) {
        const m = openMarker;
        close();
        m.focus();
      }
    });
    document.addEventListener("click", (e) => {
      if (openItem && !openItem.contains(e.target as Node)) close();
    });
    window.addEventListener("resize", () => {
      if (openItem && openMarker) position(openItem, openMarker);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-nc-annotate]").forEach(initAnnotate);

  // 程式碼塊複製鈕（design_handoff_mdx_codeblock）：複製原始碼，1.6s 內顯示「已複製」綠勾。
  document.querySelectorAll<HTMLButtonElement>(".nc-cb__copy").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>(".nc-cb__copy-label");
    const textCopy = label?.dataset.copy ?? "複製";
    const textCopied = label?.dataset.copied ?? "已複製";
    let timer: number | undefined;
    btn.addEventListener("click", () => {
      const code = btn.getAttribute("data-code") ?? "";
      // 觸發複製（成敗不影響視覺回饋；某些情境 clipboard 會 pending）。
      try {
        navigator.clipboard?.writeText(code).catch(() => {});
      } catch {
        /* noop */
      }
      // 樂觀回饋：立即顯示「已複製」綠勾，1.6s 後還原。
      btn.classList.add("is-copied");
      if (label) label.textContent = textCopied;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove("is-copied");
        if (label) label.textContent = textCopy;
      }, 1600);
    });
  });
</script>
