---
import { BASE, withBase } from "@/lib/base";
// 三欄工作台的殼（取代 BaseLayout）。規格：docs/notecraft-workbench.md §4。
//
//   .wb-app
//     Rail（52）  Sidebar（240）  .wb-main ─ Header ─ toolbar slot ─ #nc-scroll.wb-body
//
// **整頁不捲動**，只有 Body 與 Sidebar 內部捲動。`id="nc-scroll"` 刻意保留在新的捲動容器上：
// Toc.tsx 與 notes/[...slug].astro 的 inline script 共 4 處靠它找捲動容器。
//
// `bare`：Header／Toolbar／Body／Drawer 是同一份 state 的頁面（/notes、Dashboard、/plugins…）
// 由 island 自己渲染這四塊，layout 只提供 .wb-main 這個容器。此時 island **必須自己輸出 #nc-scroll.wb-body**。
import "@/styles/global.css";
import "@/styles/workbench.css";
import Rail, { type RailKey } from "@/components/wb/Rail.astro";
import Sidebar from "@/components/wb/Sidebar.astro";
import Header, { type HeaderCrumb, type HeaderPill, type HeaderTab } from "@/components/wb/Header.astro";
import Icon from "@/components/Icon.astro";
import SidebarLive from "@/components/wb/SidebarLive.tsx";
import Palette from "@/components/wb/Palette.tsx";
import ToastHost from "@/components/islands/ToastHost.tsx";
import NewNoteModal from "@/components/islands/NewNoteModal.tsx";
import TabBar from "@/components/wb/tabs/TabBar.tsx";
import { getWorkbenchIndex } from "@/lib/workbench";
import type { TabSelf } from "@/lib/wb-tabs";
import { vtType } from "@/lib/wb-nav";
import { prepaintHtml, prepaintTabs } from "@/lib/wb-tabs-prepaint";
import { seriesDone } from "@/lib/series-progress-pure";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
import { ChevronDown, FileText, Pin, X } from "lucide-react";

export interface Props {
  title: string;
  description?: string;
  rail?: RailKey;
  crumbs?: HeaderCrumb[];
  pills?: HeaderPill[];
  back?: string;
  tabs?: HeaderTab[];
  /** Body 無 padding、白底（取代舊的 bleed） */
  flush?: boolean;
  /** 頁首、工具列、Body 由頁內 island 自己渲染 */
  bare?: boolean;
  /** 頁首由 layout 靜態畫，工具列與 Body（含 #nc-scroll）由 island 輸出 */
  bareBody?: boolean;
  /** 目前頁面所屬的資料夾路徑（筆記頁）：Sidebar 會展開它的祖先鏈並標為目前項目 */
  folderPath?: string;
  clampTwo?: boolean;
  pagefindTitle?: boolean;
  indexHeader?: boolean;
  /** 這一頁是頁籤（筆記頁、資料檔頁）：頁籤列會加入／聚焦它。規格 docs/notecraft-workbench-note-tabs.md §3 */
  tab?: TabSelf;
}
const {
  title,
  description,
  rail = "",
  crumbs = [],
  pills = [],
  back,
  tabs = [],
  flush = false,
  bare = false,
  bareBody = false,
  folderPath = "",
  clampTwo = false,
  pagefindTitle = false,
  indexHeader = false,
  tab,
} = Astro.props;

const isDev = import.meta.env.DEV;
const index = await getWorkbenchIndex();
// Google Fonts 改非阻塞（loading-transitions §4.3、Q2）：先用系統字型畫出頁面，字型 CSS 到了再套用
const FONTS =
  "https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700;900&family=Noto+Sans:wght@400;500;700;900&display=swap";
// 轉場分類以原始碼內嵌進 inline script（pagereveal 要在第一次繪製前處理，等不到模組）。規格 §5.2
const vtTypeSrc = vtType.toString();

// 殼的預繪（規格 §6、§7、§8.2）：頁籤列、手機計數、系列進度、捲動位置在第一次繪製前由 inline script 畫出。
// 函式以原始碼內嵌；圖示是與 TabStrip 相同的 lucide SVG（同尺寸、同線寬）
const prepaint = {
  ws: `nc-tabs-v1:${index.workspaceLabel}`,
  self: tab ? { kind: tab.kind, id: tab.id, title: tab.title, path: tab.path, pending: tab.pending } : null,
  tabsSrc: prepaintTabs.toString(),
  htmlSrc: prepaintHtml.toString(),
  icons: {
    file: renderToStaticMarkup(createElement(FileText, { size: 13, strokeWidth: 1.7, "aria-hidden": true })),
    pin: renderToStaticMarkup(createElement(Pin, { size: 12, strokeWidth: 1.7 })),
    x: renderToStaticMarkup(createElement(X, { size: 12, strokeWidth: 2 })),
    chevron: renderToStaticMarkup(createElement(ChevronDown, { size: 12, strokeWidth: 2 })),
  },
  colors: { on: "var(--wb-blue-l)", off: "var(--wb-ink-3)", view: "var(--wb-gold)" },
};
const selfKey = tab ? `${tab.kind}:${tab.id}` : null;
const seriesDoneSrc = seriesDone.toString();
---
<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — NoteCraft</title>
    {description && <meta name="description" content={description} />}
    <script is:inline define:vars={{ base: BASE }}>
      // 首屏閃動：/notes 的靜態 HTML 畫的是「全部筆記 · List · 依資料夾」，hydrate 後才套 query 與偏好。
      // 有 query 或偏好與預設不同時，先把主區藏起來；island 掛載完會移除這個屬性。沒有 query 時什麼都不做。
      (function () {
        try {
          // 舊殼的 key（完整／細條側邊欄）已無人讀；清一次，幾個版本後再拿掉這行（v0.7.0）
          localStorage.removeItem("nc:sidebar");
        } catch (e) {}
        try {
          if (location.pathname.replace(/\/+$/, "") !== base + "/notes") return;
          var hide = location.search.length > 1;
          if (!hide) {
            var p = JSON.parse(localStorage.getItem("nc-workbench-prefs-v1") || "{}") || {};
            hide = (p.defaultView && p.defaultView !== "list") || (p.groupBy && p.groupBy !== "folder");
          }
          if (!hide) return;
          var el = document.documentElement;
          el.setAttribute("data-wb-filtering", "");
          // 保險：JS 出錯時不能讓主區永遠消失
          setTimeout(function () { el.removeAttribute("data-wb-filtering"); }, 4000);
        } catch (e) {}
      })();
    </script>
    {/* 首屏 critical CSS（規格 §4.2）：@view-transition 必須在 head 的 inline <style>。
        放在外部樣式表時，新頁很快就緒（約 40ms 內）的導覽會被 Chrome 以「opt-in disabled」中止（Task 109 實測）。
        每條規則都要與 workbench.css 的同名規則一字不差（scripts/checks/wb-critical-css.mjs 把關）。 */}
    <style is:inline>@view-transition{navigation:auto}</style>
    {/* 新頁在主區元素出現前不做第一次繪製：否則轉場快照裡沒有 nc-main，新內容會直接跳出來、沒有淡入（Task 112 實測）。
        主區開頭的標記在頁籤預繪之後，等它幾乎不增加首次繪製時間；之後的內容會繼續流進 live 的新畫面 */}
    <link rel="expect" href="#nc-pane-start" blocking="render" />
    {selfKey && (
      <script is:inline define:vars={{ ws: prepaint.ws, selfKey }}>
        // 有捲動位置要還原時，等主區解析完才第一次繪製：轉場快照已經在正確位置，不會淡入到一半跳動（§4.4、§7）。
        // 沒有要還原的頁面不付這個成本（Fast 4G 下約 135ms）。document.write 讓 link 成為 parser-inserted，blocking 才有效
        try {
          var st = JSON.parse(localStorage.getItem(ws) || "null");
          var hit = st && Array.isArray(st.tabs) && st.tabs.find(function (t) { return t && t.key === selfKey; });
          if (!location.hash && hit && hit.scroll > 0) document.write('<link rel="expect" href="#nc-pane-end" blocking="render">');
        } catch (e) {}
      </script>
    )}
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href={FONTS} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS} /></noscript>
    <script is:inline define:vars={{ base: BASE, vtTypeSrc }}>
      // 換頁轉場與舊頁進度線（規格 docs/notecraft-workbench-loading-transitions.md §5、§11）。
      (function () {
        var vtType;
        try {
          vtType = new Function("return (" + vtTypeSrc + ")")();
        } catch (e) {
          return;
        }
        var de = document.documentElement;
        // 新頁：依來源／目的網址決定 peer／drill／section；reload、無來源、簡報頁一律不轉場
        addEventListener("pagereveal", function (e) {
          var vt = e.viewTransition;
          if (!vt) return;
          var act = window.navigation && navigation.activation;
          if (act && act.navigationType === "reload") return vt.skipTransition();
          var from = (act && act.from && act.from.url) || document.referrer || null;
          var type = vtType(from, location.href, base);
          if (!type) return vt.skipTransition();
          try {
            if (vt.types) vt.types.add(type);
          } catch (err) {}
          de.setAttribute("data-nc-vt", type);
          vt.finished.finally(function () {
            de.removeAttribute("data-nc-vt");
          });
        });
        // 舊頁：點站內連結後在主區頂端插進度線（CSS 讓它 150ms 後才出現）；平板／手機的 Sidebar 抽屜先關
        var clear = function () {
          document.querySelectorAll(".nc-progress").forEach(function (n) {
            n.remove();
          });
        };
        addEventListener(
          "click",
          function (e) {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
            if (!a || (a.target && a.target !== "_self") || a.hasAttribute("download")) return;
            if (!/^https?:$/.test(a.protocol) || a.origin !== location.origin) return;
            if (a.pathname === location.pathname && a.search === location.search && a.hash) return;
            var pane = document.querySelector(".nc-main-pane");
            if (pane && !pane.querySelector(".nc-progress")) {
              var i = document.createElement("i");
              i.className = "nc-progress";
              i.setAttribute("aria-hidden", "true");
              pane.prepend(i);
            }
            if (document.body.classList.contains("wb-sb-open") && a.closest("#wb-sb")) {
              // 與 SidebarLive 的 close() 相同的 DOM 變化（焦點不還原：頁面即將離開）
              var sb = document.getElementById("wb-sb");
              var scrim = document.getElementById("wb-sb-scrim");
              var burger = document.getElementById("wb-mburger");
              if (sb) sb.classList.remove("open");
              document.body.classList.remove("wb-sb-open");
              if (scrim) scrim.hidden = true;
              if (burger) burger.setAttribute("aria-expanded", "false");
            }
          },
          true,
        );
        addEventListener("pageswap", clear);
        addEventListener("pageshow", function (e) {
          if (e.persisted) clear();
        });
      })();
    </script>
  </head>
  <body>
    <a class="wb-skip" href="#nc-main">跳到主要內容</a>
    <div class="wb-app">
      <Rail active={rail} pending={index.pending.markers} />
      <Sidebar index={index} folderPath={folderPath} />
      <script is:inline define:vars={{ seriesDoneSrc }}>
        // Sidebar 系列進度預繪（§8.2）：SSR 是 0/N，換頁時不再閃一下。之後的變動仍由 SidebarLive 處理
        try {
          var seriesDone = new Function("return (" + seriesDoneSrc + ")")();
          var map = JSON.parse(localStorage.getItem("nc-reading-progress-v1") || "{}") || {};
          document.querySelectorAll("#wb-sb [data-wb-series]").forEach(function (row) {
            var refs = [];
            try { refs = JSON.parse(row.getAttribute("data-wb-refs") || "[]"); } catch (e) {}
            var p = seriesDone(map, Array.isArray(refs) ? refs : []);
            var bar = row.querySelector(".wb-sb-prog i");
            var n = row.querySelector("[data-wb-series-n]");
            if (bar) bar.style.width = p.pct + "%";
            if (n) n.textContent = p.done + "/" + p.total;
          });
        } catch (e) {}
      </script>
      <main class="wb-main" id="nc-main">
        {/* 頁籤列：bare 與否都在。SSR 只輸出 34px 空列，hydrate 後才畫頁籤（零位移）；hydrate 前由下方的 #nt-pre 預繪 */}
        <TabBar client:load self={tab ?? null} workspace={index.workspaceLabel} />
        <button type="button" class="wb-mburger" id="wb-mburger" aria-label="開啟側欄" aria-expanded="false" aria-controls="wb-sb">
          <Icon name="layers" size={16} stroke={1.7} />
        </button>
        {/* 手機（≤860）的頁籤計數鈕位置：SSR 是空框，TabBar 以 portal 填入按鈕 */}
        <div class="nt-count-slot" id="nt-count-slot" data-pagefind-ignore></div>
        {/* 頁籤列預繪層（§6）：蓋在 island 的空列上，island 畫好頁籤後由 TabBar 移除。不可改 island 自己的 DOM */}
        <div class="nt-pre" id="nt-pre" aria-hidden="true" data-pagefind-ignore></div>
        <script is:inline define:vars={{ base: BASE, pp: prepaint }}>
          (function () {
            var pre = document.getElementById("nt-pre");
            try {
              var tabsOf = new Function("return (" + pp.tabsSrc + ")")();
              var htmlOf = new Function("return (" + pp.htmlSrc + ")")();
              var raw = null;
              try { raw = localStorage.getItem(pp.ws); } catch (e) { return; }
              var tabs = tabsOf(raw, pp.self, base);
              pre.innerHTML = htmlOf(tabs, pp.icons, pp.colors);
              if (window.performance && performance.mark) performance.mark("nc-tabs-prepaint");
              // 溢出：active 捲進可視區（左右 24px）、兩側遮罩，與 TabStrip 相同
              var sc = pre.querySelector(".nt-scroll");
              var on = pre.querySelector(".nt-tab.on");
              if (sc && on) {
                var l = on.offsetLeft, r = l + on.offsetWidth;
                if (l < sc.scrollLeft + 24) sc.scrollLeft = l - 24;
                else if (r > sc.scrollLeft + sc.clientWidth - 24) sc.scrollLeft = r - sc.clientWidth + 24;
              }
              if (sc) {
                var w = sc.parentNode;
                if (sc.scrollLeft > 2) w.classList.add("fl");
                if (sc.scrollLeft + sc.clientWidth < sc.scrollWidth - 2) w.classList.add("fr");
              }
              // 手機計數框（≤860）：與 TabBar portal 的按鈕同外觀
              var slot = document.getElementById("nt-count-slot");
              if (slot && raw !== null) {
                var c = document.createElement("span");
                c.className = "nt-count nt-count-pre" + (tabs.some(function (t) { return t.on; }) ? " on" : "");
                c.setAttribute("aria-hidden", "true");
                c.innerHTML = '<span class="tnum">' + tabs.length + "</span>";
                slot.appendChild(c);
              }
            } catch (e) {
              pre.innerHTML = "";
            }
            // 保險：island 已 hydrate 卻沒移除預繪層（例如 TabBar 例外）時，1 秒後移除，避免蓋住真的頁籤列。
            // island 一直沒 hydrate（JS 失敗）時保留：預繪層的連結仍可導覽
            var island = pre.parentNode.querySelector("astro-island");
            var tries = 0;
            var timer = setInterval(function () {
              if (!document.getElementById("nt-pre")) return clearInterval(timer);
              if (island && !island.hasAttribute("ssr")) {
                clearInterval(timer);
                setTimeout(function () {
                  var p = document.getElementById("nt-pre");
                  if (p) p.remove();
                  document.querySelectorAll(".nt-count-pre").forEach(function (n) { n.remove(); });
                }, 1000);
              } else if (++tries > 120) clearInterval(timer);
            }, 250);
          })();
        </script>
        {/* 換頁時只有這一塊轉場（view-transition-name: nc-main）；規格 docs/notecraft-workbench-loading-transitions.md §4.1 */}
        <div class="nc-main-pane">
        <i id="nc-pane-start" hidden></i>
        {bare ? (
          <slot />
        ) : (
          <>
            <Header
              title={title}
              crumbs={crumbs}
              pills={pills}
              back={back}
              tabs={tabs}
              clampTwo={clampTwo}
              pagefindTitle={pagefindTitle}
              indexHeader={indexHeader}
            >
              <slot name="pills" slot="pills" />
              <slot name="actions" slot="actions" />
            </Header>
            {bareBody ? (
              <slot />
            ) : (
              <>
                <slot name="toolbar" />
                <div id="nc-scroll" class:list={["wb-body", { flush }]}>
                  <slot />
                </div>
              </>
            )}
          </>
        )}
        {selfKey && (
          <script is:inline define:vars={{ ws: prepaint.ws, selfKey }}>
            // 捲動還原提前到第一次繪製前（§7、Q4）。條件與 TabBar 相同：網址有 hash 時讓位
            try {
              var el = document.getElementById("nc-scroll");
              var st = JSON.parse(localStorage.getItem(ws) || "null");
              var hit = st && Array.isArray(st.tabs) && st.tabs.find(function (t) { return t && t.key === selfKey; });
              if (el && !location.hash && hit && hit.scroll > 0) {
                el.scrollTop = hit.scroll;
                // 記下實際設到的值：TabBar hydrate 時若位置已不同，代表使用者自己捲過，不再搶回
                el.setAttribute("data-nc-restored", String(el.scrollTop));
              }
            } catch (e) {}
          </script>
        )}
        <i id="nc-pane-end" hidden></i>
        </div>
      </main>
    </div>
    <SidebarLive client:idle />
    <Palette client:idle workspace={index.workspaceLabel} />
    <ToastHost client:idle />
    {isDev && <NewNoteModal client:idle />}
    <script is:inline>
      // 殼的兩顆事件型按鈕：Rail 的搜尋、頁首的「＋ 新增筆記」。只 dispatch 事件，由對應的 island 接。
      // 用事件而非 getElementById 綁定：island 渲染的頁首可能晚於 Modal 的 effect 才掛載，直接綁會綁不到。
      document.addEventListener("click", function (e) {
        var t = e.target && e.target.closest ? e.target : null;
        if (!t) return;
        if (t.closest("[data-wb-open-palette]")) window.dispatchEvent(new CustomEvent("nc-open-palette"));
        else if (t.closest("[data-wb-new-note]")) window.dispatchEvent(new CustomEvent("nc-open-new-note"));
      });
    </script>
  </body>
</html>
