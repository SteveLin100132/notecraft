---
// 壓縮頁首（README §3.4）：麵包屑、返回鍵、h1、pill、右側動作、連結型 Tab。
// React 版在 WbHeader.tsx（給頁首由 island 自己渲染的頁面用）。**兩份的 DOM 結構必須一致**。
import Icon from "@/components/Icon.astro";

export type HeaderPill = { label: string; tone?: "default" | "ok" | "warn" | "muted" | "danger"; href?: string; class?: string };
export type HeaderCrumb = { label: string; href?: string };
export type HeaderTab = { label: string; href: string; active?: boolean };

export interface Props {
  title: string;
  crumbs?: HeaderCrumb[];
  pills?: HeaderPill[];
  back?: string;
  tabs?: HeaderTab[];
  /** 筆記頁：標題放寬為最多兩行（其餘頁面單行省略）。 */
  clampTwo?: boolean;
  /** 在 h1 上標 data-pagefind-meta="title"（h1 位於 data-pagefind-body 之外時用）。 */
  pagefindTitle?: boolean;
  /** 在 h1 上標 data-pagefind-body（資料檔頁：只索引標題與描述）。 */
  indexHeader?: boolean;
}
const { title, crumbs = [], pills = [], back, tabs = [], clampTwo = false, pagefindTitle = false, indexHeader = false } = Astro.props;
const isDev = import.meta.env.DEV;
---
<header class="wb-hd">
  <div class="wb-hd-top">
    <div style="min-width:0">
      <nav class="wb-crumb" aria-label="麵包屑">
        {crumbs.map((c, i) => (
          <>
            {i > 0 && <span aria-hidden="true">{"  /  "}</span>}
            {c.href ? <a href={c.href}>{c.label}</a> : <span>{c.label}</span>}
          </>
        ))}
      </nav>
      <div class="wb-hd-title-row">
        {back && (
          <a class="wb-dw-x" href={back} title="返回" aria-label="返回"><Icon name="arrowLeft" size={15} stroke={1.7} /></a>
        )}
        <h1
          class:list={["wb-hd-title", { clamp2: clampTwo }]}
          title={title}
          data-pagefind-meta={pagefindTitle ? "title" : undefined}
          data-pagefind-body={indexHeader ? "" : undefined}
        >{title}</h1>
        {pills.map((p) =>
          p.href ? (
            <a class:list={["wb-pill", "tnum", p.tone && p.tone !== "default" ? p.tone : "", p.class]} href={p.href}>{p.label}</a>
          ) : (
            <span class:list={["wb-pill", "tnum", p.tone && p.tone !== "default" ? p.tone : "", p.class]}>{p.label}</span>
          ),
        )}
        <slot name="pills" />
      </div>
    </div>
    <div class="wb-hd-actions">
      <slot name="actions" />
      {isDev && (
        <button type="button" class="wb-btn-gold" data-wb-new-note>
          <Icon name="plus" size={14} stroke={2.2} /> 新增筆記
        </button>
      )}
    </div>
  </div>
  {tabs.length > 1 && (
    <nav class="wb-tabs" aria-label="檢視">
      {tabs.map((t) => (
        <a class:list={["wb-tab", { on: t.active }]} href={t.href} aria-current={t.active ? "page" : undefined}>{t.label}</a>
      ))}
    </nav>
  )}
</header>
