---
import { withBase } from "@/lib/base";
import Icon from "./Icon.astro";
import VizZoom from "@/components/islands/VizZoom.tsx";
import { toVscodeHref } from "@/lib/vscode-href.mjs";

export interface Props {
  id: string;
  type?: string;
  caption?: string;
  prompt?: string;
  /**
   * 資料檔模式：外框結構、間距、圓角、陰影、放大檢視全部不動，只換標示 ——
   * 膠囊改橘色 Database、mono 改成真實資料檔路徑、dev 按鈕改「以 VS Code 編輯」
   * 並多一顆「開啟完整檢視頁」。「重新生成」對資料檔不成立（它不是 AI 生成的）。
   * `anchor`：附加在「開啟完整檢視頁」後的 hash（不含 #），由 <PluginView anchor> 傳入，app 不解讀。
   */
  dataFile?: { relPath: string; routePath: string; pluginTitle: string; absPath: string; anchor?: string };
}
const { id, type = "free", caption, prompt, dataFile } = Astro.props;
const isDev = import.meta.env.DEV;

const TYPE_LABELS: Record<string, string> = {
  motion: "動畫",
  chart: "圖表",
  diagram: "示意圖",
  timeline: "時間軸",
  table: "表格",
  free: "視覺化",
};
const label = TYPE_LABELS[type] ?? "視覺化";
---
{/* 外框（note-page §7）：.nc-viz 樣式在 global.css 的 prose 區段。放大鈕（VizZoom）與「複製提示詞」維持現況（Q9） */}
<figure class:list={["nc-viz", { "nc-viz--data": !!dataFile }]}>
  <div class="nc-viz__h">
    {dataFile ? (
      <span class="nc-viz__k">
        <Icon name="layers" size={13} stroke={2} /> 資料檔 · {dataFile.pluginTitle}
      </span>
    ) : (
      <span class="nc-viz__k">
        <span class="nc-viz__ic"><Icon name="sparkle" size={13} stroke={2} /></span> {label}
        <span class="nc-viz__ty">· {type}</span>
      </span>
    )}
    <code class="nc-viz__f">{dataFile ? dataFile.relPath : `generated/${id}.tsx`}</code>
    {dataFile && (
      <a
        class="nc-viz__open"
        href={withBase(`/view/${dataFile.routePath}`) + (dataFile.anchor ? `#${dataFile.anchor}` : "")}
        title="開啟完整檢視頁"
      >
        開啟檢視頁 <Icon name="external" size={11} stroke={2} />
      </a>
    )}
    {dataFile && isDev && (
      <a class="nc-viz__btn" href={toVscodeHref(dataFile.absPath)} title="以 VS Code 編輯這份資料">
        <Icon name="edit" size={12} /> 以 VS Code 編輯
      </a>
    )}
    {prompt && !dataFile && (
      <span style="display:inline-flex;align-items:center;position:relative;">
        <button type="button" class="nc-viz__btn" data-nc-copy-prompt aria-label="複製提示詞" title="複製生成此元件的提示詞">
          <Icon name="clipboard" size={12} />
          <span data-nc-copy-label>複製提示詞</span>
        </button>
        <script type="application/json" data-nc-prompt set:html={JSON.stringify(prompt)} />
      </span>
    )}
    {/* 放大檢視：常駐於標題列最右側，把下方 data-nc-viz-body 的元件搬進全螢幕畫布 */}
    <VizZoom
      client:visible
      id={id}
      kind={dataFile ? "資料檔" : label}
      type={dataFile ? undefined : type}
      caption={caption}
      codeLabel={dataFile?.relPath}
      icon={dataFile ? "database" : "sparkle"}
    />
  </div>
  <div class="nc-viz__b">
    <div data-nc-viz-body>
      <slot />
    </div>
  </div>
  {caption && <figcaption class="nc-viz__c">{caption}</figcaption>}
</figure>

<script>
  import { COPY_FAILED_MSG, writeClipboard } from "@/lib/clipboard";

  // 事件委派：整頁只綁定一次（Astro 會去重相同的 hoisted script）
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    const btn = target.closest<HTMLButtonElement>("[data-nc-copy-prompt]");
    if (!btn) return;
    const node = btn.parentElement?.querySelector("[data-nc-prompt]");
    if (!node) return;
    let prompt = "";
    try {
      prompt = JSON.parse(node.textContent || '""');
    } catch {
      prompt = node.textContent || "";
    }
    const label = btn.querySelector("[data-nc-copy-label]");
    const done = () => {
      if (!label) return;
      const prev = label.textContent;
      label.textContent = "已複製";
      window.setTimeout(() => {
        label.textContent = prev;
      }, 1800);
    };
    void writeClipboard(prompt).then((ok) => {
      if (ok) done();
      else window.dispatchEvent(new CustomEvent("nc-toast", { detail: { msg: COPY_FAILED_MSG, icon: "x" } }));
    });
  });
</script>
