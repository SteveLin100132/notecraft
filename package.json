{
  "name": "notecraftapp",
  "type": "module",
  "version": "0.1.3",
  "description": "由 AI 生成視覺化與動態互動元件、嵌入筆記的個人筆記 Web App。用 npx 一行指令在任何 md/mdx 資料夾啟動漂亮 UI。",
  "keywords": [
    "notecraft",
    "notecraftapp",
    "mdx",
    "markdown",
    "notes",
    "viewer",
    "astro",
    "cli",
    "documentation",
    "ai",
    "claude",
    "visualization",
    "interactive"
  ],
  "author": "建宇",
  "license": "MIT",
  "homepage": "https://github.com/SteveLin100132/notecraft#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SteveLin100132/notecraft.git"
  },
  "bugs": {
    "url": "https://github.com/SteveLin100132/notecraft/issues"
  },
  "bin": {
    "notecraftapp": "./bin/notecraftapp.mjs"
  },
  "files": [
    "bin/",
    "src/components/*.astro",
    "src/components/islands/",
    "src/content/config.ts",
    "src/data/series.ts",
    "src/dev-api/",
    "src/env.d.ts",
    "src/layouts/",
    "src/lib/",
    "src/pages/",
    "src/styles/",
    "astro.config.mjs",
    "tailwind.config.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "new-note": "node scripts/new-note.mjs",
    "viewer:view": "node bin/notecraftapp.mjs view",
    "viewer:build": "node bin/notecraftapp.mjs build",
    "viewer:serve": "node bin/notecraftapp.mjs serve"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.3",
    "@astrojs/react": "^4.1.2",
    "@astrojs/tailwind": "^5.1.4",
    "astro": "^5.0.5",
    "citty": "^0.2.2",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "motion": "^11.15.0",
    "pagefind": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.0",
    "remark-directive": "^4.0.0",
    "tailwind-merge": "^2.5.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
